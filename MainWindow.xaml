<Window x:Class="AcVelocity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:AcVelocity.Converters"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        Title="VELOCITY // NEXUS - Autonomous Simulation Matrix" 
        Height="950" Width="1500"
        MinHeight="740" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <conv:StringToImageSourceConverter x:Key="ImgConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Glass Panel Style -->
        <Style x:Key="GlassPanelStyle" TargetType="{x:Type Border}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E0111522" Offset="0"/>
                        <GradientStop Color="#C00D1018" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradient}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Accent Tag Style -->
        <Style x:Key="RedBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#26FF1E40"/>
            <Setter Property="BorderBrush" Value="#80FF1E40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- Navigation Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#8E99A8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="tabBorder" Background="Transparent" CornerRadius="6" Padding="14,8" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#26FF1E40"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#80FF1E40"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonRedBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#8E99A8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="tabBorder" Background="Transparent" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="activeIndicator" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource NeonRedBrightBrush}" Margin="0,0,10,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#22FF1E40"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#4DFF1E40"/>
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonRedBrightBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Style -->
        <Style x:Key="FilterPillStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#8E99A8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="pillBorder" Background="#14FFFFFF" CornerRadius="6" Padding="10,5" BorderThickness="1" BorderBrush="#22FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#33FF1E40"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#FF1E40"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonRedBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Container with Cyber Border -->
    <Border Background="#090B0F" 
            CornerRadius="16" 
            BorderBrush="#33FF1E40" 
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#FF1E40" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- Top Cyber App Bar with Title & Controls -->
                <RowDefinition Height="*"/>  <!-- Main Body Content (Sidebar + Tab Views) -->
                <RowDefinition Height="38"/> <!-- Bottom Status Terminal Dock -->
            </Grid.RowDefinitions>

            <!-- Background Ambient Glows -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                <Ellipse Width="650" Height="650" Canvas.Right="-150" Canvas.Top="-150">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#26FF1E40" Offset="0"/>
                            <GradientStop Color="#00FF1E40" Offset="0.7"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="550" Height="550" Canvas.Left="-150" Canvas.Bottom="-150">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1AFF1E40" Offset="0"/>
                            <GradientStop Color="#00FF1E40" Offset="0.8"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- ================= TOP CYBER APP BAR ================= -->
            <Border Grid.Row="0" 
                    Background="#D90B0E14" 
                    BorderBrush="#1AFFFFFF" 
                    BorderThickness="0,0,0,1" 
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Brand & Active Module -->
                        <ColumnDefinition Width="*"/>    <!-- Center Live Status -->
                        <ColumnDefinition Width="Auto"/> <!-- Window Controls & Counters -->
                    </Grid.ColumnDefinitions>

                    <!-- Brand Title & Active Module Pill -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource RedNeonGradient}" Margin="0,0,10,0">
                            <TextBlock Text="V" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="VELOCITY" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="//" Foreground="{StaticResource NeonRedBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="NEXUS" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,18,0"/>

                        <!-- Current Module Breadcrumb -->
                        <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MODULE // " Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentTab}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center Live Status Feed -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource NeonRedBrightBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Action Controls & Fleet Stats -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#14FFFFFF" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AllCars.Count, StringFormat='{}{0} CARS'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#14FFFFFF" CornerRadius="12" Padding="10,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#FF1E40" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AllTracks.Count, StringFormat='{}{0} TRACKS'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Button Click="BtnMinimize_Click" Width="36" Height="30" Background="Transparent" BorderThickness="0" Foreground="#8E99A8" Cursor="Hand" Content="—" FontSize="13"/>
                        <Button Click="BtnClose_Click" Width="36" Height="30" Background="Transparent" BorderThickness="0" Foreground="#8E99A8" Cursor="Hand" Content="✕" FontSize="13" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN BODY CONTENT (SIDEBAR + TAB VIEWS) ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/> <!-- Left Cyber Navigation Sidebar -->
                    <ColumnDefinition Width="*"/>   <!-- Main Tab Views Content -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT CYBER NAVIGATION SIDEBAR ================= -->
                <Border Grid.Column="0" 
                        Background="#0D1017" 
                        BorderBrush="#1AFFFFFF" 
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Scrollable Navigation Tabs -->
                            <RowDefinition Height="Auto"/> <!-- Bottom Engine / Hardware Status Card -->
                        </Grid.RowDefinitions>

                        <!-- Scrollable Navigation Tabs -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,16,14,16">
                                <!-- Category 1: SIMULATION MATRIX -->
                                <TextBlock Text="SIMULATION MATRIX" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
                                <RadioButton Content="🕹️  LAUNCH DECK" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsLauncherTab, Mode=TwoWay}" Click="NavTab_Click" Tag="LAUNCHER"/>
                                <RadioButton Content="🎛️  PRESETS" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsPresetsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="PRESETS"/>
                                <RadioButton Content="🎮  CONTROLS &amp; FFB" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsControlsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="CONTROLS"/>
                                <RadioButton Content="⚡  CSP MATRIX" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsCspTab, Mode=TwoWay}" Click="NavTab_Click" Tag="CSP"/>

                                <Separator Background="#14FFFFFF" Margin="10,12,10,12"/>

                                <!-- Category 2: GRAPHICS & ACOUSTICS -->
                                <TextBlock Text="GRAPHICS &amp; ACOUSTICS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
                                <RadioButton Content="🌐  ONLINE MATRIX" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsOnlineTab, Mode=TwoWay}" Click="NavTab_Click" Tag="ONLINE"/>
                                <RadioButton Content="⚙️  GRAPHICS CORE" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsGraphicsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="GRAPHICS"/>
                                <RadioButton Content="🔊  AUDIO &amp; ASSISTS" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsAudioTab, Mode=TwoWay}" Click="NavTab_Click" Tag="AUDIO"/>

                                <Separator Background="#14FFFFFF" Margin="10,12,10,12"/>

                                <!-- Category 3: ASSETS & SYSTEM -->
                                <TextBlock Text="ASSETS &amp; SYSTEM" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
                                <RadioButton Content="📁  SYSTEM &amp; FILES" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsSystemTab, Mode=TwoWay}" Click="NavTab_Click" Tag="SYSTEM"/>
                                <RadioButton Content="🎨  SKINS &amp; LIVERIES" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsSkinsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="SKINS"/>
                                <RadioButton Content="📦  MODS DEPOT" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsModsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="MODS"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Active Engine / Fleet Card -->
                        <Border Grid.Row="1" Background="#0A0D14" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="ACS ENGINE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                    <Border Background="#1400E5FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="ARMED" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SelectedCar.DisplayTitle, FallbackValue='No Vehicle Selected'}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedTrack.DisplayTitle, FallbackValue='No Circuit Selected'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= MAIN TAB VIEWS CONTENT ================= -->
                <Grid Grid.Column="1">

                <!-- TAB 1: LAUNCH DECK (HERO + CAR & TRACK MATRICES) -->
                <ScrollViewer Visibility="{Binding IsLauncherTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,24,36,40">

                        <!-- Hero Section -->
                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Hero Copy -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                <Border Style="{StaticResource RedBadgeStyle}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="⚡ AUTONOMOUS SIMULATION MATRIX" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                </Border>

                                <TextBlock Text="DIRECT DISPATCH." Foreground="#FFFFFF" FontWeight="Black" FontSize="42" LineHeight="48" Margin="0,0,0,2"/>
                                <TextBlock Text="ZERO-LATENCY RACING." Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Black" FontSize="42" LineHeight="48" Margin="0,0,0,16"/>

                                <TextBlock Text="High-bandwidth Assetto Corsa launcher engine with neural telemetry synthesis, dynamic environmental parameters, and drag-and-drop mod integration."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,24"/>

                                <TextBlock Text="SESSION DISPATCH MODE" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <RadioButton Content="PRACTICE" GroupName="SessionMode" IsChecked="True" Checked="SessionMode_Checked" Tag="PRACTICE" Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,8,0" Padding="14,8" Foreground="#FFFFFF" Background="#14FFFFFF" BorderBrush="#33FFFFFF" Cursor="Hand"/>
                                    <RadioButton Content="HOTLAP" GroupName="SessionMode" Checked="SessionMode_Checked" Tag="HOTLAP" Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,8,0" Padding="14,8" Foreground="#FFFFFF" Background="#14FFFFFF" BorderBrush="#33FFFFFF" Cursor="Hand"/>
                                    <RadioButton Content="RACE" GroupName="SessionMode" Checked="SessionMode_Checked" Tag="RACE" Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,8,0" Padding="14,8" Foreground="#FFFFFF" Background="#14FFFFFF" BorderBrush="#33FFFFFF" Cursor="Hand"/>
                                    <RadioButton Content="DRIFT" GroupName="SessionMode" Checked="SessionMode_Checked" Tag="DRIFT" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,8" Foreground="#FFFFFF" Background="#14FFFFFF" BorderBrush="#33FFFFFF" Cursor="Hand"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Click="BtnLaunchSimulation_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="28,14" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="EXECUTE SIMULATION" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnRefreshContent_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="18,14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⟳" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SYNC DEPOT" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right Spotlight Card with Real-Time Skin Ribbon -->
                            <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Padding="24" Cursor="Hand" MouseLeftButtonDown="SpotlightCar_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="230"/>
                                        <RowDefinition Height="Auto"/> <!-- Interactive Skin Ribbon -->
                                        <RowDefinition Height="Auto"/> <!-- 4-Specs HUD -->
                                        <RowDefinition Height="Auto"/> <!-- AI Telemetry Advisor -->
                                    </Grid.RowDefinitions>

                                    <!-- Title & Skin Tag -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SelectedCar.DisplayBrand}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="ExtraBold" FontSize="13"/>
                                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                <TextBlock Text="{Binding SelectedCar.DisplayClass}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                <TextBlock Text="{Binding SelectedCar.OriginBadge}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedCar.DisplayTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="22" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource RedBadgeStyle}">
                                            <TextBlock Text="{Binding SelectedCar.SelectedSkin}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Car Preview Image (Clickable with badge) -->
                                    <Border Grid.Row="1" CornerRadius="10" Background="#0A0C12" Margin="0,0,0,12" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="[ NO PREVIEW RENDER ]" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            <Image Source="{Binding SelectedCar.PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=800}" Stretch="UniformToFill"/>

                                            <!-- Click To Change Badge Overlay -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" 
                                                    Background="#D90E121B" BorderBrush="#80FF1E40" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔍 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CLICK TO CHANGE CAR" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Quick Skin Selection Ribbon -->
                                    <Grid Grid.Row="2" Margin="0,0,0,12">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding SelectedCar.SkinList}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="SkinItem_Click">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#C8D2DE" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- 4-Grid HUD Specs -->
                                    <Grid Grid.Row="3" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="POWER" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedCar.Bhp}" Foreground="#FFFFFF" FontSize="14" FontWeight="ExtraBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8" Padding="10,8" Margin="2,0,2,0">
                                            <StackPanel>
                                                <TextBlock Text="TORQUE" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedCar.Torque}" Foreground="#FFFFFF" FontSize="14" FontWeight="ExtraBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="8" Padding="10,8" Margin="2,0,2,0">
                                            <StackPanel>
                                                <TextBlock Text="WEIGHT" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedCar.Weight}" Foreground="#FFFFFF" FontSize="14" FontWeight="ExtraBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Background="#14FFFFFF" CornerRadius="8" Padding="10,8" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="TOP SPEED" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedCar.TopSpeed}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="14" FontWeight="ExtraBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- AI Advisor & Integrity Button -->
                                    <Border Grid.Row="4" Background="#15FF1E40" BorderBrush="#33FF1E40" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🧠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="AI TELEMETRY: Power-to-weight ratio verified. Optimal trail-braking bias." Foreground="#C8D2DE" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Click="BtnCheckCarIntegrity_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔍 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="VERIFY ASSET INTEGRITY" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Section 2: Environmental Matrix -->
                        <TextBlock Text="SIMULATION MATRIX // MISSION PARAMETERS" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,14,0" Cursor="Hand" MouseLeftButtonDown="SpotlightTrack_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="110"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="LOCKED CIRCUIT" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                <TextBlock Text="{Binding SelectedTrack.OriginBadge}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedTrack.DisplayTitle}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SelectedTrack.DisplayLocation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" CornerRadius="8" Background="#0A0C12" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="[ NO PREVIEW RENDER ]" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                            <Image Source="{Binding SelectedTrack.PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=500}" Stretch="UniformToFill"/>
                                            <!-- Click To Change Track Badge Overlay -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" 
                                                    Background="#D90E121B" BorderBrush="#80FF1E40" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔍 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CLICK TO CHANGE CIRCUIT" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SelectedTrack.DisplayLength}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="{Binding SelectedTrack.Pitboxes, StringFormat='{}{0} PITS'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="AI GRID DISPATCH" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="GRID CAPACITY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Slider Minimum="0" Maximum="23" Value="{Binding AiCount, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding AiCount, StringFormat='{}{0} AI RIVAL VEHICLES'}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="NEURAL SKILL LEVEL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Slider Minimum="80" Maximum="100" Value="{Binding AiDifficulty, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding AiDifficulty, StringFormat='{}{0}% AGGRESSION'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="ENVIRONMENTAL &amp; WEATHER MATRIX" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <!-- Weather Selector -->
                                    <TextBlock Text="WEATHER PRESET" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableWeatherPresets}" SelectedItem="{Binding WeatherName, Mode=TwoWay}" Style="{StaticResource FuturisticComboBoxStyle}" Margin="0,0,0,10"/>

                                    <!-- Time of Day -->
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="TIME OF DAY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding TimeOfDayDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="360" Value="{Binding SunAngle, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                    <!-- Track Grip & Ambient Temp -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Grid>
                                                <TextBlock Text="TRACK GRIP" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                <TextBlock Text="{Binding TrackGripDisplay}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="90" Maximum="100" Value="{Binding TrackGrip, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Grid>
                                                <TextBlock Text="AMBIENT TEMP" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                <TextBlock Text="{Binding AmbientTempDisplay}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="10" Maximum="40" Value="{Binding AmbientTemp, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Time Acceleration Multiplier -->
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="TIME SPEED ACCELERATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding TimeMultiplierDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="24" Value="{Binding TimeMultiplier, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Vehicle Filtering & Hangar Command Station -->
                        <Border Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Top Row: Title, Available Count, and Reset Filters Button -->
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="VEHICLE HANGAR" Foreground="#FFFFFF" FontSize="18" FontWeight="Black" Margin="0,0,12,0"/>
                                        <Border Style="{StaticResource RedBadgeStyle}">
                                            <TextBlock Text="{Binding FilteredCars.Count, StringFormat='{}{0} AVAILABLE'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Click="BtnResetFilters_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,5" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="RESET FILTERS" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Bottom Row: Brand Dropdown, Origin Category Pills, Class Category Pills, and Model Search Box -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Brand Selector Dropdown -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="BRAND:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Width="160" ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                                  Style="{StaticResource FuturisticComboBoxStyle}"/>
                                    </StackPanel>

                                    <!-- 2. Origin Category Pills -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="ORIGIN:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton Content="ALL" GroupName="CarOriginFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL" Click="CarOriginPill_Click"/>
                                        <RadioButton Content="👑 OFFICIAL" GroupName="CarOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="OFFICIAL" Click="CarOriginPill_Click"/>
                                        <RadioButton Content="📦 MODS" GroupName="CarOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="MODS" Click="CarOriginPill_Click"/>
                                    </StackPanel>

                                    <!-- 3. Class Category Pills -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="CLASS:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton Content="ALL" GroupName="ClassFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL CLASSES" Click="ClassPill_Click"/>
                                        <RadioButton Content="STREET" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="STREET" Click="ClassPill_Click"/>
                                        <RadioButton Content="RACE" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="RACE" Click="ClassPill_Click"/>
                                        <RadioButton Content="DRIFT" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="DRIFT" Click="ClassPill_Click"/>
                                        <RadioButton Content="SUPERCAR" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="SUPERCAR" Click="ClassPill_Click"/>
                                        <RadioButton Content="TRAFFIC" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="TRAFFIC" Click="ClassPill_Click"/>
                                    </StackPanel>

                                    <!-- 4. Model Search Box -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="220" Text="{Binding CarSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource FuturisticTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding FilteredCars}" 
                                 SelectedItem="{Binding SelectedCar}" 
                                 Height="520"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Margin="0,0,0,32">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel ItemSize="275,230" SpacingMode="None"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="0,0,10,12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="cardBorder" Style="{StaticResource GlassPanelStyle}" Padding="12" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#80FF1E40"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                                                        <Setter TargetName="cardBorder" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=300}" Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#CC0B0E14" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding OriginBadge}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding DisplayBrand}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Bhp}" Foreground="#E0E6ED" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DisplayClass}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Tracks Section Grid -->
                        <Border Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="CIRCUIT MATRIX" Foreground="#FFFFFF" FontSize="18" FontWeight="Black" Margin="0,0,12,0"/>
                                        <Border Style="{StaticResource RedBadgeStyle}">
                                            <TextBlock Text="{Binding FilteredTracks.Count, StringFormat='{}{0} CIRCUITS'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Click="BtnResetTrackFilters_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,5" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="RESET FILTERS" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Origin Category Pills for Tracks -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="ORIGIN:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton Content="ALL" GroupName="TrackOriginFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL" Click="TrackOriginPill_Click"/>
                                        <RadioButton Content="👑 OFFICIAL" GroupName="TrackOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="OFFICIAL" Click="TrackOriginPill_Click"/>
                                        <RadioButton Content="📦 MODS" GroupName="TrackOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="MODS" Click="TrackOriginPill_Click"/>
                                    </StackPanel>

                                    <!-- Track Search Box -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="260" Text="{Binding TrackSearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding FilteredTracks}" 
                                 SelectedItem="{Binding SelectedTrack}" 
                                 Height="460"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Margin="0,0,0,24">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel ItemSize="275,200" SpacingMode="None"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="0,0,10,12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="trackBorder" Style="{StaticResource GlassPanelStyle}" Padding="12" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="trackBorder" Property="BorderBrush" Value="{StaticResource CyberCyanBrush}"/>
                                                        <Setter TargetName="trackBorder" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="[ NO PREVIEW ]" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=300}" Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#CC0B0E14" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding OriginBadge}" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayLocation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DisplayLength}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: LIVERY & SKINS SHOWROOM GALLERY -->
                <Grid Visibility="{Binding IsSkinsTab, Converter={StaticResource BoolToVis}}" Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="LIVERY &amp; SKIN REPOSITORIES" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedCar.DisplayTitle, StringFormat='{}VEHICLE: {0}'}" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                        <TextBlock Text="Select skin livery to apply to active simulation matrix profile." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedCar.SkinList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="330" ItemHeight="260"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="16" Margin="0,0,16,16" Cursor="Hand" MouseLeftButtonDown="SkinItem_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="160"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,10">
                                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=500}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="CLICK TO ENGAGE LIVERY" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- TAB: SIMULATION PRESETS MATRIX -->
                <ScrollViewer Visibility="{Binding IsPresetsTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,24,36,40">
                        <!-- Header -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SIMULATION MATRIX // PRESET ENGINE" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="CROSS-SUBSYSTEM PROFILE SWITCHER" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                                <TextBlock Text="Instant unified profiles synchronizing Direct3D 11 Video, Custom Shaders Patch, and Wheel Force Feedback." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </StackPanel>

                            <!-- Custom Preset Quick-Save Input -->
                            <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Padding="16,10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtNewPresetName" Width="180" Text="MY_CUSTOM_PRO" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,10,0"/>
                                    <Button Click="BtnSaveCurrentPreset_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SAVE AS PRESET" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Presets Grid -->
                        <ItemsControl ItemsSource="{Binding AvailablePresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="440" ItemHeight="260"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,18,18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="34" Height="34" CornerRadius="8" Background="#26FF1E40" BorderBrush="#80FF1E40" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="16" FontWeight="Black"/>
                                                        <TextBlock Text="UNIFIED SIMULATION PROFILE" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

                                            <!-- Footer / Apply Button -->
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="CSP" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="VIDEO" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="FFB" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>

                                                <Button Click="BtnApplyPreset_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="18,8" HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="APPLY PROFILE" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: CONTROLS & FORCE FEEDBACK MATRIX -->
                <ScrollViewer Visibility="{Binding IsControlsTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,24,36,40">
                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DIRECTINPUT &amp; XINPUT TELEMETRY // STEERING, PEDALS &amp; TRANSMISSION" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="CONTROLS &amp; FORCE FEEDBACK MATRIX" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                                <TextBlock Text="Configure hardware steering wheels, pedal gamma calibration curves, H-pattern shifter vs paddles, dynamic gamepad telemetry, and wheel buttons directly in controls.ini." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </StackPanel>

                            <Button Grid.Column="1" Click="BtnSaveFfb_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="22,12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="COMMIT CONTROLS [controls.ini]" FontWeight="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Hardware Device & Input Method Selection Glass Banner -->
                        <Border Style="{StaticResource GlassPanelStyle}" Padding="18,14" Margin="0,0,0,20" BorderBrush="#3300E5FF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="INPUT SYSTEM:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <RadioButton Content="🏎️ STEERING WHEEL" GroupName="InputMethodGroup" Style="{StaticResource FilterPillStyle}" Tag="WHEEL" IsChecked="{Binding FfbSettings.IsWheelMode, Mode=TwoWay}" Click="InputMethodPill_Click" Margin="0,0,8,0"/>
                                    <RadioButton Content="🎮 GAMEPAD (X360)" GroupName="InputMethodGroup" Style="{StaticResource FilterPillStyle}" Tag="X360" IsChecked="{Binding FfbSettings.IsGamepadMode, Mode=TwoWay}" Click="InputMethodPill_Click" Margin="0,0,8,0"/>
                                    <RadioButton Content="⌨️ KEYBOARD &amp; MOUSE" GroupName="InputMethodGroup" Style="{StaticResource FilterPillStyle}" Tag="KEYBOARD" IsChecked="{Binding FfbSettings.IsKeyboardMode, Mode=TwoWay}" Click="InputMethodPill_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                        <TextBlock Text="{Binding FfbSettings.DeviceStatusDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Wheel Base Motor & Pedals Matrix -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                <!-- CARD 1: WHEEL BASE MOTOR DYNAMICS -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="WHEEL BASE MOTOR DYNAMICS" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,16"/>

                                        <!-- Master Gain -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="FFB MASTER GAIN (MOTOR TORQUE STRENGTH)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.DisplayMasterGain}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.2" Maximum="1.5" Value="{Binding FfbSettings.MasterGain, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,16"/>

                                        <!-- Filter -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="FFB SMOOTHING FILTER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.Filter, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="0.5" Value="{Binding FfbSettings.Filter, Mode=TwoWay}" SmallChange="0.01" Margin="0,0,0,16"/>

                                        <!-- Min Force -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="MINIMUM MOTOR FORCE (DEADZONE ELIMINATION)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.MinForce, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="0.2" Value="{Binding FfbSettings.MinForce, Mode=TwoWay}" SmallChange="0.01" Margin="0,0,0,16"/>

                                        <!-- Steering Lock -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="HARDWARE STEERING ROTATION LOCK" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.DisplayLock}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Content="360°" Style="{StaticResource FilterPillStyle}" Grid.Column="0" Tag="360" Click="SteeringLock_Click"/>
                                            <RadioButton Content="540°" Style="{StaticResource FilterPillStyle}" Grid.Column="1" Tag="540" Click="SteeringLock_Click"/>
                                            <RadioButton Content="900°" Style="{StaticResource FilterPillStyle}" Grid.Column="2" Tag="900" IsChecked="True" Click="SteeringLock_Click"/>
                                            <RadioButton Content="1080°" Style="{StaticResource FilterPillStyle}" Grid.Column="3" Tag="1080" Click="SteeringLock_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: PEDAL CALIBRATION & TRANSMISSION MATRIX -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="PEDAL AXIS CALIBRATION &amp; TRANSMISSION" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,16"/>

                                        <!-- Throttle Gamma -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="THROTTLE GAMMA (ACCELERATOR RESPONSE CURVE)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.DisplayThrottleGamma}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="1.0" Maximum="3.0" Value="{Binding FfbSettings.ThrottleGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,14"/>

                                        <!-- Brake Gamma -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="BRAKE PRESSURE GAMMA (LOAD CELL / PROGRESSIVE)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.DisplayBrakesGamma}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="1.0" Maximum="4.0" Value="{Binding FfbSettings.BrakesGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,6"/>
                                        <TextBlock Text="💡 2.4 - 3.2 recommended for load-cell or stiff rubber brake mods." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,14"/>

                                        <!-- Clutch Gamma -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="CLUTCH BITE GAMMA" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.DisplayClutchGamma}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="1.0" Maximum="2.5" Value="{Binding FfbSettings.ClutchGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,14"/>

                                        <!-- Handbrake Gamma -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="HANDBRAKE SENSITIVITY GAMMA" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.DisplayHandbrakeGamma}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="1.0" Maximum="2.0" Value="{Binding FfbSettings.HandbrakeGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,16"/>

                                        <!-- Transmission Shifter Mode -->
                                        <TextBlock Text="TRANSMISSION SHIFTER MODE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Content="🏎️ PADDLE SHIFTERS" GroupName="ShifterModeGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="0" Tag="PADDLES" IsChecked="{Binding FfbSettings.IsPaddleMode, Mode=TwoWay}" Click="ShifterMode_Click" Margin="0,0,4,0"/>
                                            <RadioButton Content="🕹️ H-PATTERN SHIFTER" GroupName="ShifterModeGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="1" Tag="HSHIFTER" IsChecked="{Binding FfbSettings.HShifterActive, Mode=TwoWay}" Click="ShifterMode_Click" Margin="4,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding FfbSettings.ShifterModeDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- Right Column: Surface Chatter, Gamepad Matrix & Button HUD -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                <!-- CARD 3: SURFACE & TIRE CHATTER TELEMETRY -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="SURFACE &amp; TIRE CHATTER TELEMETRY" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,16"/>

                                        <!-- Kerbs -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="KERBS RUMBLE INTENSITY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.KerbsEffect, StringFormat='{}{0:P0}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.KerbsEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                        <!-- Road -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="ROAD SURFACE GRAIN DETAIL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.RoadEffect, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.RoadEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                        <!-- Slip -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="TIRE SLIP &amp; LOSS-OF-TRACTION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.SlipEffect, StringFormat='{}{0:P0}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.SlipEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                        <!-- ABS -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="ABS BRAKE PULSE VIBRATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.AbsEffect, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.AbsEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                        <CheckBox Content="ENHANCED UNDERSTEER EFFECT (WEIGHT DROP)" IsChecked="{Binding FfbSettings.EnhancedUndersteer, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 4: GAMEPAD DYNAMIC TUNING MATRIX (XINPUT) -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <TextBlock Text="GAMEPAD DYNAMIC TUNING (XINPUT)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="#1400E5FF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="X360 / DUALSENSE" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Speed Sensitivity -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="SPEED SENSITIVITY (HIGH-SPEED DAMPING)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.GamepadSpeedSensitivity, StringFormat='{}{0:F2}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.GamepadSpeedSensitivity, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                        <!-- Steer Speed -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="STEER SPEED (JOYSTICK RESPONSE RATE)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding FfbSettings.GamepadSteerSpeed, StringFormat='{}{0:F2}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.05" Maximum="1.0" Value="{Binding FfbSettings.GamepadSteerSpeed, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                        <!-- Deadzone & Filter -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="DEADZONE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding FfbSettings.GamepadSteerDeadzone, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="0.2" Value="{Binding FfbSettings.GamepadSteerDeadzone, Mode=TwoWay}" SmallChange="0.01"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="STEER FILTER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding FfbSettings.GamepadSteerFilter, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.GamepadSteerFilter, Mode=TwoWay}" SmallChange="0.05"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Steer Gamma & Rumble Intensity -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="STEER GAMMA" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding FfbSettings.GamepadSteerGamma, StringFormat='{}{0:F1}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                </Grid>
                                                <Slider Minimum="1.0" Maximum="4.0" Value="{Binding FfbSettings.GamepadSteerGamma, Mode=TwoWay}" SmallChange="0.1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="RUMBLE INTENSITY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding FfbSettings.GamepadRumbleIntensity, StringFormat='{}{0:P0}'}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                </Grid>
                                                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.GamepadRumbleIntensity, Mode=TwoWay}" SmallChange="0.05"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 5: QUICK BUTTON ASSIGNMENTS HUD -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <TextBlock Text="HARDWARE BUTTON MAPPINGS // HUD" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="DirectInput Direct Bindings" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <!-- Gear Up / Down -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,4,8">
                                                <StackPanel>
                                                    <TextBlock Text="SHIFT UP PADDLE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FfbSettings.ButtonGearUp}" Foreground="{StaticResource CyberCyanBrush}" FontSize="12" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="4,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="SHIFT DOWN PADDLE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FfbSettings.ButtonGearDown}" Foreground="{StaticResource CyberCyanBrush}" FontSize="12" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Headlights / Flash -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,4,8">
                                                <StackPanel>
                                                    <TextBlock Text="HEADLIGHTS TOGGLE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FfbSettings.ButtonHeadlights}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="4,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="HIGH BEAM FLASH" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FfbSettings.ButtonHeadlightsFlash}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Horn / Camera -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,4,8">
                                                <StackPanel>
                                                    <TextBlock Text="HORN" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FfbSettings.ButtonHorn}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="4,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="CHANGE CAMERA" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FfbSettings.ButtonChangeCamera}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- TC / ABS -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="TRACTION CONTROL (TC)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="UP: " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding FfbSettings.ButtonTcUp}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                                        <TextBlock Text="DN: " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding FfbSettings.ButtonTcDown}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="ANTI-LOCK BRAKES (ABS)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="UP: " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding FfbSettings.ButtonAbsUp}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                                        <TextBlock Text="DN: " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding FfbSettings.ButtonAbsDown}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: ONLINE MULTIPLAYER MATRIX (LIVE SERVER BROWSER + DIRECT DISPATCH) -->
                <Grid Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}" Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="ONLINE MATRIX // SERVER DIRECTORY &amp; DISPATCH" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="HIGH-PERFORMANCE MULTIPLAYER" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                            <TextBlock Text="Browse live servers parsed from Content Manager bookmarks or enter direct IP for zero-latency dispatch." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <Button Click="BtnRefreshServers_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="REFRESH SERVERS" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live Server Browser List -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <TextBlock Text="BOOKMARKED &amp; ACTIVE SERVERS" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource RedBadgeStyle}">
                                        <TextBlock Text="{Binding OnlineServers.Count, StringFormat='{}{0} BOOKMARKS'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <ListBox Grid.Row="1" ItemsSource="{Binding OnlineServers}" SelectedItem="{Binding SelectedOnlineServer}"
                                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="4"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <Border x:Name="serverRowBorder" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Cursor="Hand">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="serverRowBorder" Property="Background" Value="#1CFFFFFF"/>
                                                                <Setter TargetName="serverRowBorder" Property="BorderBrush" Value="#60FF1E40"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="serverRowBorder" Property="Background" Value="#26FF1E40"/>
                                                                <Setter TargetName="serverRowBorder" Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Track}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                        <TextBlock Text="{Binding AddressDisplay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Players & Ping -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                    <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding PlayersDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding PingMs, StringFormat='{}{0}ms'}" Foreground="#C8D2DE" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Quick Connect Button -->
                                                <Button Grid.Column="2" Click="BtnConnectServerItem_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="12,6" VerticalAlignment="Center">
                                                    <TextBlock Text="JOIN" FontSize="11" FontWeight="Black"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right: Direct Connect Form & Assigned Vehicle -->
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="DIRECT CONNECTION DISPATCH" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>

                                    <TextBlock Text="REMOTE HOST ADDRESS (IP / DOMAIN)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding OnlineServerIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="PORT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding OnlineServerPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="PASSWORD" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding OnlinePassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="CALLSIGN / PILOT NAME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding OnlinePilotName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,20"/>

                                    <Button Click="BtnLaunchOnline_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="20,12" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CONNECT TO ONLINE SERVER" FontSize="12" FontWeight="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Active Assigned Vehicle Preview -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="ASSIGNED VEHICLE" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Border CornerRadius="8" Background="#0A0D14" Height="140" ClipToBounds="True" Margin="0,0,0,10">
                                        <Image Source="{Binding SelectedCar.PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=600}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedCar.DisplayTitle}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedCar.DisplayBrand}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- TAB 4: GRAPHICS & DISPLAY CORE -->
                <Grid Visibility="{Binding IsGraphicsTab, Converter={StaticResource BoolToVis}}" Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="GRAPHICS &amp; HARDWARE CORE" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="DIRECT3D 11 ENGINE TUNING" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                        <TextBlock Text="Optimize resolution, rendering fidelity, and anti-aliasing directly in video.ini." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Display Panel -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="24" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="DISPLAY MATRIX" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="WIDTH (PX)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding VideoSettings.Width, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="HEIGHT (PX)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding VideoSettings.Height, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="REFRESH RATE (HZ)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding VideoSettings.RefreshRate, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,14"/>

                                <CheckBox Content="EXCLUSIVE FULLSCREEN MODE" IsChecked="{Binding VideoSettings.Fullscreen, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,14"/>
                                <CheckBox Content="VERTICAL SYNC (VSYNC)" IsChecked="{Binding VideoSettings.VSync, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,14"/>
                            </StackPanel>
                        </Border>

                        <!-- Rendering Quality Panel -->
                        <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="FIDELITY &amp; SHADERS" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>

                                <TextBlock Text="MSAA ANTI-ALIASING SAMPLES (0, 2, 4, 8)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding VideoSettings.Msaa, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="SHADOW RESOLUTION MAP (1024, 2048, 4096)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding VideoSettings.ShadowMapSize, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,14"/>

                                <CheckBox Content="FAST APPROXIMATE ANTI-ALIASING (FXAA)" IsChecked="{Binding VideoSettings.Fxaa, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,24"/>

                                <Button Click="BtnSaveGraphics_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="24,14" HorizontalAlignment="Left">
                                    <TextBlock Text="COMMIT GRAPHICS PROFILE" FontWeight="Black"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- TAB 5: MOD INJECTOR (DRAG & DROP) -->
                <Grid Visibility="{Binding IsModsTab, Converter={StaticResource BoolToVis}}" Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="MOD INJECTOR // ASSET DEPLOYMENT" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="DRAG &amp; DROP MOD ARCHIVES" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                        <TextBlock Text="Drop any .zip car or track mod archive anywhere into this window to automatically unpack and integrate." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>

                    <!-- Large Futuristic Drop Zone -->
                    <Border Grid.Row="1" Style="{StaticResource GlassPanelStyle}" BorderBrush="{StaticResource NeonRedBrush}" BorderThickness="2" CornerRadius="16" Padding="40">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="72" Height="72" CornerRadius="36" Background="#26FF1E40" BorderBrush="#80FF1E40" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="⇩" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="DROP ZIP / 7Z MOD PACKAGES HERE" Foreground="#FFFFFF" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Automated taxonomy parser will detect vehicle or circuit and install to content depot." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                                <Button Click="BtnBrowseMod_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="20,12" HorizontalAlignment="Center">
                                    <TextBlock Text="OR BROWSE LOCAL ARCHIVE..." FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 6: CUSTOM SHADERS PATCH (CSP) MATRIX -->
                <ScrollViewer Visibility="{Binding IsCspTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,24,36,40">

                        <!-- CSP Header & Status HUD Banner -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Style="{StaticResource RedBadgeStyle}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CspSettings.StatusDisplay}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{Binding CspSettings.WeatherImplementation, StringFormat='{}ENGINE: {0}'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="CUSTOM SHADERS PATCH // CONTROL MATRIX" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                                <TextBlock Text="Full-spectrum visual synthesis, dynamic illumination, physical rain simulations, and realism shaders." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="BtnInstallCspZip_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="16,12" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="INSTALL CSP [.ZIP]" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnSaveCsp_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="22,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="COMMIT CSP CONFIGURATION" FontWeight="Black" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Diagnostics & Master Toggle Glass Banner -->
                        <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,24" BorderBrush="#33FF1E40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource RedNeonGradient}" Margin="0,0,16,0">
                                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CUSTOM SHADERS PATCH CORE INJECTION" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Direct3D 11 byte-level intercept via dwrite.dll active in Assetto Corsa root." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="12,6" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="CORE BINARY: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CspSettings.DwriteSizeMb, StringFormat='{}dwrite.dll ({0} MB)'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <CheckBox Content="MASTER CSP ENABLED" IsChecked="{Binding CspSettings.MasterEnabled, Mode=TwoWay}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="ExtraBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 6 Core Feature Panels in Responsive Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                <!-- CARD 1: WEATHER FX (WFX) -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌦️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="WEATHER FX (WFX)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox Content="ACTIVE" IsChecked="{Binding CspSettings.WeatherFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="ACTIVE WEATHER ENGINE // IMPLEMENTATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding CspSettings.AvailableWeatherImplementations}" SelectedItem="{Binding CspSettings.WeatherImplementation, Mode=TwoWay}" Style="{StaticResource FuturisticComboBoxStyle}" Margin="0,0,0,14"/>

                                        <TextBlock Text="WEATHER CONTROLLER SCRIPT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding CspSettings.AvailableWeatherControllers}" SelectedItem="{Binding CspSettings.WeatherController, Mode=TwoWay}" Style="{StaticResource FuturisticComboBoxStyle}" Margin="0,0,0,14"/>

                                        <CheckBox Content="PHOTOREALISTIC SKY &amp; MIRAGE REFLECTIONS" IsChecked="{Binding CspSettings.MirageReflections, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: LIGHTING FX (LFX) -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="LIGHTING FX (LFX)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox Content="ACTIVE" IsChecked="{Binding CspSettings.LightingFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="HEADLIGHTS BEAM RANGE MULTIPLIER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding CspSettings.HeadlightsRangeMult, StringFormat='{}{0:F1}x'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0.5" Maximum="2.0" Value="{Binding CspSettings.HeadlightsRangeMult, Mode=TwoWay}" SmallChange="0.1" LargeChange="0.2" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="MAX OPPONENT CARS WITH ACTIVE BEAMS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding CspSettings.CarsWithLights, StringFormat='{}{0} CARS'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="4" Maximum="30" Value="{Binding CspSettings.CarsWithLights, Mode=TwoWay}" Margin="0,0,0,14"/>

                                        <CheckBox Content="DYNAMIC OPPONENT HEADLIGHTS &amp; BEAMS" IsChecked="{Binding CspSettings.DynamicCarLights, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <CheckBox Content="BOUNCED COCKPIT &amp; ROAD LIGHT" IsChecked="{Binding CspSettings.BouncedLight, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <CheckBox Content="FULL-RESOLUTION DYNAMIC SHADOW MAPS" IsChecked="{Binding CspSettings.FullResShadows, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 3: IMMERSION & REALISM FX -->
                                <Border Style="{StaticResource GlassPanelStyle}" Padding="22">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🏎️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="IMMERSION &amp; REALISM FX" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>

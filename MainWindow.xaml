<Window x:Class="AcVelocity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:AcVelocity.Converters"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        Title="AcVelocity - Assetto Corsa Launcher" 
        Height="950" Width="1500"
        MinHeight="740" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <conv:StringToImageSourceConverter x:Key="ImgConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Clean Glass Card Panel Style -->
        <Style x:Key="GlassPanelStyle" TargetType="{x:Type Border}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EC131824" Offset="0"/>
                        <GradientStop Color="#D80F141E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradient}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- Red Accent Tag Badge Style -->
        <Style x:Key="RedBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#22E11D48"/>
            <Setter Property="BorderBrush" Value="#80E11D48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- Navigation Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#8E99A8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="tabBorder" Background="Transparent" CornerRadius="6" Padding="14,8" BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#26E11D48"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#80E11D48"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonRedBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#8E99A8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="tabBorder" Background="Transparent" CornerRadius="8" Padding="12,9" BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="activeIndicator" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource NeonRedBrightBrush}" Margin="0,0,10,0" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#22E11D48"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#4DE11D48"/>
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonRedBrightBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Style -->
        <Style x:Key="FilterPillStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#8E99A8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="pillBorder" Background="#14FFFFFF" CornerRadius="6" Padding="10,5" BorderThickness="1" BorderBrush="#22FFFFFF" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#33E11D48"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonRedBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Container -->
    <Border Background="#090C12" 
            CornerRadius="12" 
            BorderBrush="#222B3C" 
            BorderThickness="1"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Top Clean App Bar with Title & Controls -->
                <RowDefinition Height="*"/>  <!-- Main Body Content (Sidebar + Tab Views) -->
                <RowDefinition Height="36"/> <!-- Bottom Status Terminal Dock -->
            </Grid.RowDefinitions>

            <!-- Background Ambient Glows (Toned Down & Clean) -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                <Ellipse Width="650" Height="650" Canvas.Right="-150" Canvas.Top="-150">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#08E11D48" Offset="0"/>
                            <GradientStop Color="#00E11D48" Offset="0.7"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="550" Height="550" Canvas.Left="-150" Canvas.Bottom="-150">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#05E11D48" Offset="0"/>
                            <GradientStop Color="#00E11D48" Offset="0.8"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- ================= TOP APP BAR ================= -->
            <Border Grid.Row="0" 
                    Background="#D90E1420" 
                    BorderBrush="#1A283246" 
                    BorderThickness="0,0,0,1" 
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Brand & Active Module -->
                        <ColumnDefinition Width="*"/>    <!-- Center Live Status -->
                        <ColumnDefinition Width="Auto"/> <!-- Window Controls & Counters -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Title & Active Module Pill -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource RedNeonGradient}" Margin="0,0,10,0">
                            <TextBlock Text="AC" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AC VELOCITY" Foreground="#FFFFFF" FontWeight="Black" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Assetto Corsa Launcher" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <!-- Current Module Breadcrumb -->
                        <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="เมนู / " Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentTab}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center Live Status Feed -->
                    <Border Grid.Column="1" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource NeonRedBrightBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Action Controls & Fleet Stats -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#14FFFFFF" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏎️ รถ " Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AllCars.Count}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text=" คัน" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#14FFFFFF" CornerRadius="12" Padding="10,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏁 สนาม " Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AllTracks.Count}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text=" สนาม" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Button Click="BtnMinimize_Click" Width="36" Height="30" Background="Transparent" BorderThickness="0" Foreground="#8E99A8" Cursor="Hand" Content="—" FontSize="13"/>
                        <Button Click="BtnClose_Click" Width="36" Height="30" Background="Transparent" BorderThickness="0" Foreground="#8E99A8" Cursor="Hand" Content="✕" FontSize="13" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN BODY CONTENT (SIDEBAR + TAB VIEWS) ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/> <!-- Left Clean Navigation Sidebar -->
                    <ColumnDefinition Width="*"/>   <!-- Main Tab Views Content -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT SIDEBAR NAVIGATION ================= -->
                <Border Grid.Column="0" 
                        Background="#0D1017" 
                        BorderBrush="#1A283246" 
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Scrollable Navigation Tabs -->
                            <RowDefinition Height="Auto"/> <!-- Bottom Engine / Hardware Status Card -->
                        </Grid.RowDefinitions>

                        <!-- Scrollable Navigation Tabs -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,16,14,16">
                                <!-- Category 1: PLAY (เริ่มเล่นเกม) -->
                                <TextBlock Text="เริ่มเล่นเกม (PLAY)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
                                <RadioButton Content="🏁  ขับเล่นด่วน (Quick Drive)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsLauncherTab, Mode=TwoWay}" Click="NavTab_Click" Tag="LAUNCHER"/>
                                <RadioButton Content="🌐  เล่นออนไลน์ (Online Servers)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsOnlineTab, Mode=TwoWay}" Click="NavTab_Click" Tag="ONLINE"/>
                                <RadioButton Content="🎨  เปลี่ยนสีรถ (Car Skins)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsSkinsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="SKINS"/>
                                <RadioButton Content="📦  ลงม็อดรถ/สนาม (Install Mods)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsModsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="MODS"/>

                                <Separator Background="#14FFFFFF" Margin="10,12,10,12"/>

                                <!-- Category 2: SETTINGS (ตั้งค่าเกม) -->
                                <TextBlock Text="ตั้งค่าเกม (SETTINGS)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
                                <RadioButton Content="🎮  ปุ่มกด &amp; พวงมาลัย (Controls)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsControlsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="CONTROLS"/>
                                <RadioButton Content="⚡  ม็อดภาพ CSP (Shaders Patch)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsCspTab, Mode=TwoWay}" Click="NavTab_Click" Tag="CSP"/>
                                <RadioButton Content="🖥️  จอภาพ &amp; กราฟิก (Graphics)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsGraphicsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="GRAPHICS"/>
                                <RadioButton Content="🔊  เสียง &amp; ตัวช่วยขับ (Audio &amp; Assists)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsAudioTab, Mode=TwoWay}" Click="NavTab_Click" Tag="AUDIO"/>

                                <Separator Background="#14FFFFFF" Margin="10,12,10,12"/>

                                <!-- Category 3: SYSTEM (ระบบและพรีเซ็ต) -->
                                <TextBlock Text="ระบบและพรีเซ็ต (SYSTEM)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
                                <RadioButton Content="💾  พรีเซ็ตสำเร็จรูป (Presets)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsPresetsTab, Mode=TwoWay}" Click="NavTab_Click" Tag="PRESETS"/>
                                <RadioButton Content="🛠️  จัดการไฟล์ &amp; ล้างแคช (System)" GroupName="MainSidebarNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="{Binding IsSystemTab, Mode=TwoWay}" Click="NavTab_Click" Tag="SYSTEM"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Active Engine / Fleet Card -->
                        <Border Grid.Row="1" Background="#0A0D14" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="พร้อมเข้าเกม (READY TO DRIVE)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                    <Border Background="#1400E5FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="READY" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SelectedCar.DisplayTitle, FallbackValue='ยังไม่ได้เลือกรถ'}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedTrack.DisplayTitle, FallbackValue='ยังไม่ได้เลือกสนาม'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= MAIN TAB VIEWS CONTENT ================= -->
                <Grid Grid.Column="1">

                    <!-- TAB 1: QUICK DRIVE DASHBOARD (🏁 ขับเล่นด่วน) -->
                    <ScrollViewer Visibility="{Binding IsLauncherTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,20,32,36">

                            <!-- Top Action Header Bar -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🏁 ขับเล่นด่วน (Quick Drive)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="24" Margin="0,0,0,3"/>
                                    <TextBlock Text="เลือกรถ เลือกสนาม และตั้งค่าสภาพอากาศก่อนเริ่มเกม" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="BtnRefreshContent_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="16,10" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⟳" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="รีเฟรชม็อด (Rescan)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnLaunchSimulation_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="28,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="เริ่มเข้าเกม (START GAME)" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: 3-Column Clean Setup Dashboard -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: 🏎️ รถที่ใช้ขับ (Selected Car) -->
                                <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,14,0" Cursor="Hand" MouseLeftButtonDown="SpotlightCar_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="165"/>
                                            <RowDefinition Height="Auto"/> <!-- Interactive Skin Ribbon -->
                                            <RowDefinition Height="Auto"/> <!-- 4 Specs HUD -->
                                            <RowDefinition Height="Auto"/> <!-- Verify Integrity Action -->
                                        </Grid.RowDefinitions>

                                        <!-- Header & Skin Badge -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="1. รถที่เลือก (SELECTED CAR)" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" FontSize="11"/>
                                                    <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                    <TextBlock Text="{Binding SelectedCar.DisplayBrand}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                    <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                    <TextBlock Text="{Binding SelectedCar.OriginBadge}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedCar.DisplayTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource RedBadgeStyle}">
                                                <TextBlock Text="{Binding SelectedCar.SelectedSkin}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Car Preview Image with Overlay Badge -->
                                        <Border Grid.Row="1" CornerRadius="8" Background="#0A0C12" Margin="0,0,0,10" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="[ ไม่มีภาพตัวอย่าง ]" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                                <Image Source="{Binding SelectedCar.PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=600}" Stretch="UniformToFill"/>

                                                <!-- Change Car Badge Overlay -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" 
                                                        Background="#D90E121B" BorderBrush="#80FF1E40" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔍 " FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="คลิกเพื่อเปลี่ยนรถ (Change Car)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Quick Skin Ribbon -->
                                        <Grid Grid.Row="2" Margin="0,0,0,10">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding SelectedCar.SkinList}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="SkinItem_Click">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#C8D2DE" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>

                                        <!-- 4 Clean Spec Boxes -->
                                        <Grid Grid.Row="3" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="แรงม้า (BHP)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedCar.Bhp}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="6" Padding="8,6" Margin="3,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="แรงบิด (NM)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedCar.Torque}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="6" Padding="8,6" Margin="3,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="น้ำหนัก (KG)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedCar.Weight}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="#14FFFFFF" CornerRadius="6" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="ความเร็วสูงสุด" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedCar.TopSpeed}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Footer with Integrity Verify Button -->
                                        <Button Grid.Row="4" Click="BtnCheckCarIntegrity_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="10,6" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🔍 " FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="ตรวจเช็กไฟล์รถ (Verify Car Files)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Column 1: 🏁 สนามแข่ง (Selected Track) -->
                                <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,14,0" Cursor="Hand" MouseLeftButtonDown="SpotlightTrack_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="185"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="2. สนามแข่ง (SELECTED TRACK)" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                    <TextBlock Text="{Binding SelectedTrack.OriginBadge}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedTrack.DisplayTitle}" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SelectedTrack.DisplayLocation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Track Preview Image with Overlay Badge -->
                                        <Border Grid.Row="1" CornerRadius="8" Background="#0A0C12" Margin="0,0,0,12" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="[ ไม่มีภาพตัวอย่าง ]" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                                <Image Source="{Binding SelectedTrack.PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=500}" Stretch="UniformToFill"/>

                                                <!-- Change Track Badge Overlay -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" 
                                                        Background="#D90E121B" BorderBrush="#8000E5FF" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔍 " FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="คลิกเพื่อเปลี่ยนสนาม (Change Track)" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Track Info Pills -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="ระยะทาง (Length)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedTrack.DisplayLength}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="ช่องจอดพิต (Pitboxes)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedTrack.Pitboxes, StringFormat='{}{0} คัน'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Column 2: ⚙️ ตั้งค่าการเล่น & สภาพอากาศ (Session & Weather) -->
                                <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="3. โหมดการเล่น &amp; สภาพอากาศ (SESSION SETUP)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <!-- Driving Mode Pills -->
                                        <TextBlock Text="โหมดการขับขี่ (Mode):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Content="ซ้อมขับ" GroupName="SessionMode" IsChecked="True" Checked="SessionMode_Checked" Tag="PRACTICE" Style="{StaticResource FilterPillStyle}" Grid.Column="0" Margin="0,0,2,0"/>
                                            <RadioButton Content="จับเวลา" GroupName="SessionMode" Checked="SessionMode_Checked" Tag="HOTLAP" Style="{StaticResource FilterPillStyle}" Grid.Column="1" Margin="2,0,2,0"/>
                                            <RadioButton Content="แข่ง" GroupName="SessionMode" Checked="SessionMode_Checked" Tag="RACE" Style="{StaticResource FilterPillStyle}" Grid.Column="2" Margin="2,0,2,0"/>
                                            <RadioButton Content="ดริฟต์" GroupName="SessionMode" Checked="SessionMode_Checked" Tag="DRIFT" Style="{StaticResource FilterPillStyle}" Grid.Column="3" Margin="2,0,0,0"/>
                                        </Grid>

                                        <!-- Weather Selector -->
                                        <TextBlock Text="สภาพอากาศ (Weather):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding AvailableWeatherPresets}" SelectedItem="{Binding WeatherName, Mode=TwoWay}" Style="{StaticResource FuturisticComboBoxStyle}" Margin="0,0,0,10"/>

                                        <!-- Time of Day -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="เวลาในเกม (Time of Day):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding TimeOfDayDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="360" Value="{Binding SunAngle, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                        <!-- Track Grip & Ambient Temp -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <Grid>
                                                    <TextBlock Text="ความเกาะถนน:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding TrackGripDisplay}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Minimum="90" Maximum="100" Value="{Binding TrackGrip, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="อุณหภูมิ:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding AmbientTempDisplay}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Minimum="10" Maximum="40" Value="{Binding AmbientTemp, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- AI Opponents & Aggression -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <Grid>
                                                    <TextBlock Text="คู่แข่ง AI:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding AiCount, StringFormat='{}{0} คัน'}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="23" Value="{Binding AiCount, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="ความเก่ง AI:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding AiDifficulty, StringFormat='{}{0}%'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Minimum="80" Maximum="100" Value="{Binding AiDifficulty, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 2: คลังรถทั้งหมด (Car Garage) -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Header Row -->
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏎️ คลังรถทั้งหมด (Car Garage)" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" Margin="0,0,12,0"/>
                                            <Border Style="{StaticResource RedBadgeStyle}">
                                                <TextBlock Text="{Binding FilteredCars.Count, StringFormat='{}{0} คัน'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Click="BtnResetFilters_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,5" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ล้างตัวกรอง (Reset)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Filter Bar -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Brand Selector -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="ยี่ห้อ:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox Width="150" ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                                      Style="{StaticResource FuturisticComboBoxStyle}"/>
                                        </StackPanel>

                                        <!-- Origin Pills -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="ที่มา:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton Content="ทั้งหมด" GroupName="CarOriginFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL" Click="CarOriginPill_Click"/>
                                            <RadioButton Content="👑 ทางการ" GroupName="CarOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="OFFICIAL" Click="CarOriginPill_Click"/>
                                            <RadioButton Content="📦 ม็อด" GroupName="CarOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="MODS" Click="CarOriginPill_Click"/>
                                        </StackPanel>

                                        <!-- Class Pills -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="ประเภท:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton Content="ทั้งหมด" GroupName="ClassFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL CLASSES" Click="ClassPill_Click"/>
                                            <RadioButton Content="STREET" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="STREET" Click="ClassPill_Click"/>
                                            <RadioButton Content="RACE" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="RACE" Click="ClassPill_Click"/>
                                            <RadioButton Content="DRIFT" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="DRIFT" Click="ClassPill_Click"/>
                                            <RadioButton Content="SUPERCAR" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="SUPERCAR" Click="ClassPill_Click"/>
                                            <RadioButton Content="TRAFFIC" GroupName="ClassFilter" Style="{StaticResource FilterPillStyle}" Tag="TRAFFIC" Click="ClassPill_Click"/>
                                        </StackPanel>

                                        <!-- Search Box -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="220" Text="{Binding CarSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource FuturisticTextBoxStyle}"
                                                     Tag="ค้นหารถ..."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Car List VirtualizingWrapPanel -->
                            <ListBox ItemsSource="{Binding FilteredCars}" 
                                     SelectedItem="{Binding SelectedCar}" 
                                     Height="460"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     Margin="0,0,0,24">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel ItemSize="275,230" SpacingMode="None"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Margin" Value="0,0,10,12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border x:Name="cardBorder" Style="{StaticResource GlassPanelStyle}" Padding="12" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#80FF1E40"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                                                            <Setter TargetName="cardBorder" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,8">
                                                <Grid>
                                                    <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=300}" Stretch="UniformToFill"/>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#CC0B0E14" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding OriginBadge}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="{Binding DisplayBrand}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Bhp}" Foreground="#E0E6ED" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding DisplayClass}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Row 3: รายการสนามทั้งหมด (Track List) -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏁 รายการสนามทั้งหมด (Circuit Matrix)" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" Margin="0,0,12,0"/>
                                            <Border Style="{StaticResource RedBadgeStyle}">
                                                <TextBlock Text="{Binding FilteredTracks.Count, StringFormat='{}{0} สนาม'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Click="BtnResetTrackFilters_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,5" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ล้างตัวกรอง (Reset)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Origin Pills -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="ที่มา:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton Content="ทั้งหมด" GroupName="TrackOriginFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL" Click="TrackOriginPill_Click"/>
                                            <RadioButton Content="👑 ทางการ" GroupName="TrackOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="OFFICIAL" Click="TrackOriginPill_Click"/>
                                            <RadioButton Content="📦 ม็อด" GroupName="TrackOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="MODS" Click="TrackOriginPill_Click"/>
                                        </StackPanel>

                                        <!-- Track Search Box -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="260" Text="{Binding TrackSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource FuturisticTextBoxStyle}"
                                                     Tag="ค้นหาสนาม..."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Track List VirtualizingWrapPanel -->
                            <ListBox ItemsSource="{Binding FilteredTracks}" 
                                     SelectedItem="{Binding SelectedTrack}" 
                                     Height="420"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel ItemSize="275,200" SpacingMode="None"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Margin" Value="0,0,10,12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border x:Name="trackBorder" Style="{StaticResource GlassPanelStyle}" Padding="12" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="trackBorder" Property="BorderBrush" Value="{StaticResource CyberCyanBrush}"/>
                                                            <Setter TargetName="trackBorder" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="[ ไม่มีภาพตัวอย่าง ]" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                                    <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=300}" Stretch="UniformToFill"/>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#CC0B0E14" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding OriginBadge}" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayLocation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding DisplayLength}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 2: SKINS & LIVERIES (🎨 เปลี่ยนสีรถ) -->
                    <Grid Visibility="{Binding IsSkinsTab, Converter={StaticResource BoolToVis}}" Margin="32,20,32,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="🎨 เลือกลวดลายและสีรถ (Car Skins &amp; Liveries)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedCar.DisplayTitle, StringFormat='{}รถที่เลือก: {0}'}" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="เลือกลวดลายสีรถเพื่อใช้ขับในเกม" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedCar.SkinList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="330" ItemHeight="260"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassPanelStyle}" Padding="16" Margin="0,0,16,16" Cursor="Hand" MouseLeftButtonDown="SkinItem_Click">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="160"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,10">
                                                    <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=500}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Row="1">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                                    <TextBlock Text="คลิกเพื่อเลือกลายนี้ (Click to Select)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: QUICK PRESETS (💾 พรีเซ็ตสำเร็จรูป) -->
                    <ScrollViewer Visibility="{Binding IsPresetsTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,20,32,36">
                            <!-- Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="💾 พรีเซ็ตการตั้งค่าสำเร็จรูป (Quick Presets)" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="สลับโปรไฟล์ภาพ เสียง และการควบคุมที่ปรับแต่งไว้ล่วงหน้าได้ทันที" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                </StackPanel>

                                <!-- Custom Preset Quick-Save Input -->
                                <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Padding="14,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtNewPresetName" Width="180" Text="MY_CUSTOM_PRO" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,10,0"/>
                                        <Button Click="BtnSaveCurrentPreset_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="บันทึกพรีเซ็ตใหม่" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Presets Grid -->
                            <ItemsControl ItemsSource="{Binding AvailablePresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="440" ItemHeight="260"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,18,18">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="34" Height="34" CornerRadius="8" Background="#26E11D48" BorderBrush="#80E11D48" BorderThickness="1" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                                            <TextBlock Text="UNIFIED PROFILE" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Description -->
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                                                <!-- Footer / Apply Button -->
                                                <Grid Grid.Row="2">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="CSP" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="VIDEO" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="FFB" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <Button Click="BtnApplyPreset_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="18,8" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="ใช้งานพรีเซ็ตนี้" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 4: CONTROLS & FORCE FEEDBACK (🎮 ปุ่มกด & พวงมาลัย) -->
                    <ScrollViewer Visibility="{Binding IsControlsTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,20,32,36">
                            <!-- Top Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎮 ตั้งค่าปุ่มกด พวงมาลัย และจอย (Controls &amp; Force Feedback)" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="เลือกอุปกรณ์ โหลดโปรไฟล์ที่บันทึกไว้ หรือคลิกตั้งปุ่มคีย์บอร์ด พวงมาลัย และจอยได้ทันที" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                </StackPanel>

                                <Button Grid.Column="1" Click="BtnSaveFfb_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="22,12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="บันทึกการตั้งค่า (Save Controls)" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Card A: เลือกอุปกรณ์และจัดการโปรไฟล์ (Device & Control Profile Manager) -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="18,14" Margin="0,0,0,18" BorderBrush="#3300E5FF">
                                <StackPanel>
                                    <!-- Top Row: Input Selection + Device Status -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="อุปกรณ์ควบคุม:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <RadioButton Content="🏎️ พวงมาลัย (Wheel)" GroupName="InputMethodGroup" Style="{StaticResource FilterPillStyle}" Tag="WHEEL" IsChecked="{Binding FfbSettings.IsWheelMode, Mode=TwoWay}" Click="InputMethodPill_Click" Margin="0,0,8,0"/>
                                            <RadioButton Content="🎮 จอยเกม (Gamepad)" GroupName="InputMethodGroup" Style="{StaticResource FilterPillStyle}" Tag="X360" IsChecked="{Binding FfbSettings.IsGamepadMode, Mode=TwoWay}" Click="InputMethodPill_Click" Margin="0,0,8,0"/>
                                            <RadioButton Content="⌨️ คีย์บอร์ด (Keyboard)" GroupName="InputMethodGroup" Style="{StaticResource FilterPillStyle}" Tag="KEYBOARD" IsChecked="{Binding FfbSettings.IsKeyboardMode, Mode=TwoWay}" Click="InputMethodPill_Click"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                                <TextBlock Text="{Binding FfbSettings.DeviceStatusDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="#14FFFFFF" Margin="0,0,0,12"/>

                                    <!-- Middle Row: Profile Select & Action Buttons -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="โปรไฟล์ปัจจุบัน:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#1AE11D48" BorderBrush="#80E11D48" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                                <TextBlock Text="{Binding FfbSettings.ActiveProfileName}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <ComboBox Grid.Column="1" 
                                                  Style="{StaticResource FuturisticComboBoxStyle}"
                                                  ItemsSource="{Binding FfbSettings.SavedProfiles}"
                                                  SelectedItem="{Binding SelectedControlProfile, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayTitle"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Click="BtnLoadControlProfile_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,7" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📂" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="โหลดโปรไฟล์" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Click="BtnOverwriteControlProfile_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,7" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="บันทึกทับ" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Click="BtnDeleteControlProfile_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,7" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="ลบ" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Click="BtnOpenControlProfilesFolder_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="12,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="เปิดโฟลเดอร์" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Save As New Profile Input -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="บันทึกชื่อใหม่:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <TextBox Grid.Column="1" 
                                                 x:Name="TxtNewControlProfileName"
                                                 Text="{Binding NewControlProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FuturisticTextBoxStyle}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"
                                                 Tag="เช่น Moza_Drift_Setup"/>

                                        <Button Grid.Column="2" Click="BtnSaveNewControlProfile_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="16,7" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💾" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="บันทึกเป็นโปรไฟล์ใหม่" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Column="3" Text="บันทึกแรงต้าน FFB, องศาพวงมาลัย, แป้นเหยียบ และปุ่มกดทั้งหมดลง savedsetups/" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontStyle="Italic" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card B: 🎯 ตั้งค่าปุ่มกดทั้งหมด (Key, Wheel & Gamepad Bindings Studio) - PLACED PROMINENTLY FIRST! -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Studio Header & Filters -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="🎯 ตั้งค่าปุ่มกด (Key &amp; Button Mapping)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="คลิกปุ่ม '🎯 ตั้งปุ่ม (Bind)' แล้วกดปุ่มบนคีย์บอร์ด พวงมาลัย หรือจอยเกมได้ทันที (กด ESC เพื่อยกเลิก)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Combine with keyboard checkbox -->
                                        <CheckBox Grid.Column="1" 
                                                  Content="ใช้คีย์บอร์ดคู่กับพวงมาลัย/จอย (Combine with Keyboard)" 
                                                  IsChecked="{Binding FfbSettings.CombineWithKeyboard, Mode=TwoWay}" 
                                                  Foreground="{StaticResource CyberCyanBrush}" 
                                                  FontSize="11" FontWeight="Bold" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,16,0"/>

                                        <!-- Search Box -->
                                        <Grid Grid.Column="2" Width="220" VerticalAlignment="Center">
                                            <TextBox Style="{StaticResource FuturisticTextBoxStyle}"
                                                     Text="{Binding ControlSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11"
                                                     Padding="26,6,8,6"
                                                     Tag="ค้นหาคำสั่ง..."/>
                                            <TextBlock Text="🔍" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Grid>

                                    <!-- Category Filter Bar -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton Content="ทั้งหมด (All)" GroupName="ControlCategoryGroup" Style="{StaticResource FilterPillStyle}" Tag="ALL" IsChecked="True" Click="BtnControlCategory_Click"/>
                                        <RadioButton Content="⚙️ เกียร์และเบรกมือ (Gears)" GroupName="ControlCategoryGroup" Style="{StaticResource FilterPillStyle}" Tag="SHIFTER &amp; GEARS" Click="BtnControlCategory_Click"/>
                                        <RadioButton Content="💡 ไฟรถ แตร &amp; ปัดน้ำฝน (Lights)" GroupName="ControlCategoryGroup" Style="{StaticResource FilterPillStyle}" Tag="LIGHTS &amp; COCKPIT" Click="BtnControlCategory_Click"/>
                                        <RadioButton Content="✨ ปุ่มเสริม CSP (Extra A-F)" GroupName="ControlCategoryGroup" Style="{StaticResource FilterPillStyle}" Tag="CSP EXTRAS" Click="BtnControlCategory_Click"/>
                                        <RadioButton Content="⚡ ระบบช่วยขับ (Electronics)" GroupName="ControlCategoryGroup" Style="{StaticResource FilterPillStyle}" Tag="ELECTRONICS" Click="BtnControlCategory_Click"/>
                                        <RadioButton Content="🎥 มุมกล้อง &amp; พิต (Camera &amp; Pits)" GroupName="ControlCategoryGroup" Style="{StaticResource FilterPillStyle}" Tag="CAMERA &amp; SESSION" Click="BtnControlCategory_Click"/>
                                    </StackPanel>

                                    <!-- Table Column Header Row -->
                                    <Border Background="#101520" BorderBrush="#1E2636" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="145"/>
                                                <ColumnDefinition Width="155"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="คำสั่ง (Action)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="ปุ่มพวงมาลัย (Wheel Button)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="ปุ่มคีย์บอร์ด (Keyboard)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                                            <TextBlock Grid.Column="3" Text="ปุ่มจอย (Gamepad)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                                            <TextBlock Grid.Column="4" Text="ตั้งค่าปุ่ม (Bind)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                                            <TextBlock Grid.Column="5" Text="ล้าง" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Action Bindings ItemsControl -->
                                    <ItemsControl ItemsSource="{Binding FilteredActionBindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D111A" BorderBrush="#1E2636" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="210"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="145"/>
                                                            <ColumnDefinition Width="155"/>
                                                            <ColumnDefinition Width="36"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Col 0: Action Info (Display Name + Thai Description) -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                                                <Border Background="#1400E5FF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding SectionName, StringFormat='[{0}]'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ThaiDescription}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11"/>
                                                        </StackPanel>

                                                        <!-- Col 1: DirectInput Wheel Button Stepper -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,10,0">
                                                            <Button Click="BtnWheelBtnDec_Click" Tag="{Binding}" Style="{StaticResource GlassSecondaryButtonStyle}" Width="28" Height="28" Padding="0" Content="-" FontWeight="Bold" FontSize="13" Margin="0,0,4,0"/>
                                                            <Border Background="#090C12" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="130" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding WheelBindingDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Button Click="BtnWheelBtnInc_Click" Tag="{Binding}" Style="{StaticResource GlassSecondaryButtonStyle}" Width="28" Height="28" Padding="0" Content="+" FontWeight="Bold" FontSize="13" Margin="4,0,0,0"/>
                                                        </StackPanel>

                                                        <!-- Col 2: Keyboard Key Badge -->
                                                        <Border Grid.Column="2" Background="#090C12" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="110" VerticalAlignment="Center" Margin="6,0,10,0">
                                                            <TextBlock Text="{Binding KeyBindingDisplay, StringFormat='KEY: {0}'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Col 3: Gamepad XInput ComboBox -->
                                                        <ComboBox Grid.Column="3" 
                                                                  Style="{StaticResource FuturisticComboBoxStyle}"
                                                                  ItemsSource="{Binding DataContext.AvailableXboxButtons, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding XboxButton, Mode=TwoWay}"
                                                                  DropDownClosed="CmbXboxButton_DropDownClosed"
                                                                  VerticalAlignment="Center"
                                                                  Margin="6,0,10,0"/>

                                                        <!-- Col 4: Interactive Capture Button -->
                                                        <Button Grid.Column="4" 
                                                                Click="BtnBindControlAction_Click" 
                                                                Tag="{Binding}" 
                                                                Style="{StaticResource NeonLaunchButtonStyle}" 
                                                                Padding="12,6" 
                                                                FontSize="11"
                                                                VerticalAlignment="Center" 
                                                                Margin="6,0,6,0">
                                                            <TextBlock Text="{Binding CaptureButtonText}" FontWeight="Bold"/>
                                                        </Button>

                                                        <!-- Col 5: Clear Button -->
                                                        <Button Grid.Column="5" 
                                                                Click="BtnClearControlAction_Click" 
                                                                Tag="{Binding}" 
                                                                Style="{StaticResource GlassSecondaryButtonStyle}" 
                                                                Width="30" Height="28" Padding="0" 
                                                                Content="✕" 
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Card C: ตั้งค่าพวงมาลัย แป้นเหยียบ และความไวจอย (Wheel FFB, Pedals & Gamepad Tuning) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: FFB & Pedals -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                    <!-- CARD 1: แรงต้านพวงมาลัย (Wheel Force Feedback) -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="⚙️ แรงต้านพวงมาลัย (Wheel Force Feedback)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>

                                            <!-- Master Gain -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความแรง FFB (Master Gain):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.DisplayMasterGain}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.2" Maximum="1.5" Value="{Binding FfbSettings.MasterGain, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                            <!-- Filter -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความสมูท (Smoothing Filter):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.Filter, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="0.5" Value="{Binding FfbSettings.Filter, Mode=TwoWay}" SmallChange="0.01" Margin="0,0,0,14"/>

                                            <!-- Min Force -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="แรงต้านขั้นต่ำ (Min Force - แก้พวงมาลัยหลวมตรงกลาง):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.MinForce, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="0.2" Value="{Binding FfbSettings.MinForce, Mode=TwoWay}" SmallChange="0.01" Margin="0,0,0,14"/>

                                            <!-- Steering Lock -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="องศาพวงมาลัย (Steering Lock):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.DisplayLock}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Content="360°" Style="{StaticResource FilterPillStyle}" Grid.Column="0" Tag="360" Click="SteeringLock_Click"/>
                                                <RadioButton Content="540°" Style="{StaticResource FilterPillStyle}" Grid.Column="1" Tag="540" Click="SteeringLock_Click"/>
                                                <RadioButton Content="900°" Style="{StaticResource FilterPillStyle}" Grid.Column="2" Tag="900" IsChecked="True" Click="SteeringLock_Click"/>
                                                <RadioButton Content="1080°" Style="{StaticResource FilterPillStyle}" Grid.Column="3" Tag="1080" Click="SteeringLock_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 2: ความไวแป้นเหยียบและเกียร์ (Pedals & Shifter) -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="🦶 ความไวแป้นเหยียบและเกียร์ (Pedals &amp; Shifter)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>

                                            <!-- Throttle Gamma -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความไวคันเร่ง (Throttle Gamma):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.DisplayThrottleGamma}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="1.0" Maximum="3.0" Value="{Binding FfbSettings.ThrottleGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,14"/>

                                            <!-- Brake Gamma -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="น้ำหนักแป้นเบรก (Brake Pressure Gamma):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.DisplayBrakesGamma}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="1.0" Maximum="4.0" Value="{Binding FfbSettings.BrakesGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,4"/>
                                            <TextBlock Text="💡 แนะนำ 2.4 - 3.2 สำหรับแป้นเบรกแบบ Load-Cell หรือใส่ยางเสริม" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,14"/>

                                            <!-- Clutch Gamma -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ระยะคลัตช์ (Clutch Gamma):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.DisplayClutchGamma}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="1.0" Maximum="2.5" Value="{Binding FfbSettings.ClutchGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,14"/>

                                            <!-- Handbrake Gamma -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="เบรกมือ (Handbrake Gamma):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.DisplayHandbrakeGamma}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="1.0" Maximum="2.0" Value="{Binding FfbSettings.HandbrakeGamma, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,14"/>

                                            <!-- Shifter Mode -->
                                            <TextBlock Text="รูปแบบเกียร์ (Shifter Mode):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Content="🏎️ Paddle Shifters" GroupName="ShifterModeGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="0" Tag="PADDLES" IsChecked="{Binding FfbSettings.IsPaddleMode, Mode=TwoWay}" Click="ShifterMode_Click" Margin="0,0,4,0"/>
                                                <RadioButton Content="🕹️ H-Pattern Shifter" GroupName="ShifterModeGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="1" Tag="HSHIFTER" IsChecked="{Binding FfbSettings.HShifterActive, Mode=TwoWay}" Click="ShifterMode_Click" Margin="4,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding FfbSettings.ShifterModeDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right Column: Surface Chatter & Gamepad Tuning -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                    <!-- CARD 3: แรงสั่นสะเทือนพื้นถนน (Road & Surface Effects) -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="🛣️ แรงสั่นสะเทือนพื้นถนน (Road &amp; Surface Effects)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>

                                            <!-- Kerbs -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="สั่นเมื่อปีนขอบทาง (Kerbs Rumble):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.KerbsEffect, StringFormat='{}{0:P0}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.KerbsEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                            <!-- Road -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ผิวถนน (Road Surface Detail):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.RoadEffect, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.RoadEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                            <!-- Slip -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="อาการล้อฟรี/ไถล (Tire Slip Effect):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.SlipEffect, StringFormat='{}{0:P0}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.SlipEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                            <!-- ABS -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="แรงสั่นเบรก ABS (ABS Vibration):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.AbsEffect, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.AbsEffect, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,14"/>

                                            <CheckBox Content="ลดน้ำหนักพวงมาลัยเมื่อหน้าดื้อ (Enhanced Understeer Effect)" IsChecked="{Binding FfbSettings.EnhancedUndersteer, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 4: ตั้งค่าความไวจอยเกม (Gamepad Tuning) -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="🎮 ตั้งค่าความไวจอยเกม (Gamepad Tuning)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border HorizontalAlignment="Right" Background="#1400E5FF" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="XBOX / DUALSENSE" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Speed Sensitivity -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความหน่วงตามความเร็ว (Speed Sensitivity):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.GamepadSpeedSensitivity, StringFormat='{}{0:F2}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.GamepadSpeedSensitivity, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Steer Speed -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความไวการเลี้ยว (Steer Speed):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding FfbSettings.GamepadSteerSpeed, StringFormat='{}{0:F2}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.05" Maximum="1.0" Value="{Binding FfbSettings.GamepadSteerSpeed, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Deadzone & Filter -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="ระยะฟรี (Deadzone):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                        <TextBlock Text="{Binding FfbSettings.GamepadSteerDeadzone, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                    </Grid>
                                                    <Slider Minimum="0.0" Maximum="0.2" Value="{Binding FfbSettings.GamepadSteerDeadzone, Mode=TwoWay}" SmallChange="0.01"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="ความสมูท (Filter):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                        <TextBlock Text="{Binding FfbSettings.GamepadSteerFilter, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                    </Grid>
                                                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.GamepadSteerFilter, Mode=TwoWay}" SmallChange="0.05"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Steer Gamma & Rumble Intensity -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="ความโค้งการเลี้ยว (Gamma):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                        <TextBlock Text="{Binding FfbSettings.GamepadSteerGamma, StringFormat='{}{0:F1}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                    </Grid>
                                                    <Slider Minimum="1.0" Maximum="4.0" Value="{Binding FfbSettings.GamepadSteerGamma, Mode=TwoWay}" SmallChange="0.1"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="ความแรงสั่นจอย (Rumble):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                        <TextBlock Text="{Binding FfbSettings.GamepadRumbleIntensity, StringFormat='{}{0:P0}'}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="10"/>
                                                    </Grid>
                                                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding FfbSettings.GamepadRumbleIntensity, Mode=TwoWay}" SmallChange="0.05"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 5: ONLINE MULTIPLAYER (🌐 เล่นออนไลน์) -->
                    <Grid Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}" Margin="32,20,32,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🌐 เซิร์ฟเวอร์ออนไลน์ (Online Multiplayer)" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="ค้นหาเซิร์ฟเวอร์ เช็กม็อดที่ขาด และเชื่อมต่อเข้าเล่นได้ทันที" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="BtnScanServerMods_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="14,10" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="เช็กม็อดเซิร์ฟเวอร์" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnRefreshServers_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⟳" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="รีเฟรชเซิร์ฟเวอร์" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Server Browser List -->
                            <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title & Count -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="รายการเซิร์ฟเวอร์ที่พบ" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <CheckBox Content="พร้อมเข้าเล่นเท่านั้น" IsChecked="{Binding OnlyShowReadyServers, Mode=TwoWay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Style="{StaticResource RedBadgeStyle}">
                                                <TextBlock Text="{Binding FilteredOnlineServers.Count, StringFormat='{}{0} เซิร์ฟเวอร์'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Search Filter Bar -->
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <TextBox Text="{Binding OnlineServerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FuturisticTextBoxStyle}"
                                                 Tag="ค้นหาชื่อเซิร์ฟเวอร์, สนาม หรือไอพี..."/>
                                    </Grid>

                                    <!-- Server List -->
                                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredOnlineServers}" SelectedItem="{Binding SelectedOnlineServer}"
                                             Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="2"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                            <Border x:Name="serverRowBorder" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Cursor="Hand">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="serverRowBorder" Property="Background" Value="#1CFFFFFF"/>
                                                                    <Setter TargetName="serverRowBorder" Property="BorderBrush" Value="#60E11D48"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="serverRowBorder" Property="Background" Value="#26E11D48"/>
                                                                    <Setter TargetName="serverRowBorder" Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Track}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
                                                            <TextBlock Text="{Binding AddressDisplay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Readiness, Players & Ping -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                        <Border Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ReadinessBadge}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding PlayersDisplay}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding PingMs, StringFormat='{}{0}ms'}" Foreground="#C8D2DE" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Quick Connect Button -->
                                                    <Button Grid.Column="2" Click="BtnConnectServerItem_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="12,6" VerticalAlignment="Center">
                                                        <TextBlock Text="เข้าเล่น" FontSize="11" FontWeight="Bold"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Bottom: Add Custom Server IP:HTTP_PORT -->
                                    <Border Grid.Row="3" Background="#12FFFFFF" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="เพิ่มเซิร์ฟเวอร์ (IP:PORT):" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,10,0"/>
                                            <TextBox Grid.Column="1" x:Name="TxtCustomServerAddress" Text="15.235.228.96:63001" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Click="BtnAddCustomServer_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="14,6">
                                                <TextBlock Text="+ ตรวจสอบ &amp; เพิ่ม" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Right: Pre-Join Missing Mod Checker & Direct Connection -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>

                                    <!-- CARD 1: ตรวจเช็กม็อดก่อนเข้าเซิร์ฟเวอร์ -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,0,14" BorderBrush="#3300E5FF">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ตรวจเช็กความพร้อมม็อดก่อนเข้าเล่น" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="{Binding SelectedOnlineServer.ReadinessBadge, FallbackValue='ยังไม่ได้เลือกเซิร์ฟเวอร์'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- 3-Point Pre-Join Diagnostic Summary -->
                                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedOnlineServer.TrackStatusDisplay, FallbackValue='เลือกเซิร์ฟเวอร์เพื่อเช็กว่ามีสนามในเครื่องหรือไม่'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding SelectedOnlineServer.CspStatusDisplay, FallbackValue='ระบบพร้อมตรวจสอบเวอร์ชัน CSP ที่เซิร์ฟเวอร์กำหนด'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding SelectedOnlineServer.CarsStatusDisplay, FallbackValue='ระบบพร้อมตรวจสอบรายชื่อรถในเซิร์ฟเวอร์'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 1-Click Missing Mod Auto-Downloader + Progress Bar -->
                                            <Button Click="BtnDownloadMissingServerMods_Click"
                                                    Style="{StaticResource NeonLaunchButtonStyle}"
                                                    Padding="14,10"
                                                    Margin="0,0,0,10"
                                                    HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="📥" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ดาวน์โหลดและติดตั้งม็อดที่ขาดอัตโนมัติ" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ServerModDownloadProgress}" Height="6" Background="#14FFFFFF" Foreground="{StaticResource CyberCyanBrush}" BorderThickness="0" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ServerModDownloadStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                                            <!-- Server Entry List Car Slots -->
                                            <TextBlock Text="เลือกรถที่ต้องการขับในเซิร์ฟเวอร์:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <Border Background="#0C0F16" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Height="165" Padding="6">
                                                <ListBox ItemsSource="{Binding SelectedOnlineServer.CarSlots}"
                                                         SelectedItem="{Binding SelectedServerCarSlot, Mode=TwoWay}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ListBoxItem}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Padding" Value="6,4"/>
                                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                                            <Setter Property="Background" Value="#10FFFFFF"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1" Background="#1400E5FF" CornerRadius="4" Padding="6,2" Margin="6,0">
                                                                    <TextBlock Text="{Binding SlotBadge}" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding InstallStatusBadge}" Foreground="#E2E8F0" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 2: เชื่อมต่อตรงด้วยไอพี (Direct Connection) -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="⚡ เชื่อมต่อตรงด้วยไอพี (Direct Connection)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                                            <TextBlock Text="ที่อยู่ไอพีเซิร์ฟเวอร์ (IP / Host):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding OnlineServerIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="GAME PORT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding OnlineServerPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="HTTP PORT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding OnlineServerHttpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="รหัสผ่าน (Password)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding OnlinePassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="ชื่อผู้เล่นในเกม (Pilot / Player Name):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding OnlinePilotName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,12"/>

                                            <Button Click="BtnLaunchOnline_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="20,12" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="เข้าเซิร์ฟเวอร์ (Join Server)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- TAB 6: GRAPHICS & DISPLAY (🖥️ จอภาพ & กราฟิก) -->
                    <Grid Visibility="{Binding IsGraphicsTab, Converter={StaticResource BoolToVis}}" Margin="32,20,32,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="🖥️ ตั้งค่าจอภาพและกราฟิก (Graphics &amp; Display)" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="ปรับความละเอียด อัตราการรีเฟรช และคุณภาพกราฟิก (บันทึกลง video.ini)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Display Panel -->
                            <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="การแสดงผลหน้าจอ (Display Settings)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="ความกว้าง (Width px):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding VideoSettings.Width, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="ความสูง (Height px):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding VideoSettings.Height, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="อัตรารีเฟรชหน้าจอ (Refresh Rate Hz):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding VideoSettings.RefreshRate, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,14"/>

                                    <CheckBox Content="เปิดโหมดเต็มหน้าจอ (Exclusive Fullscreen)" IsChecked="{Binding VideoSettings.Fullscreen, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <CheckBox Content="เปิด Vertical Sync (VSync ล็อคเฟรมเรตตามจอ)" IsChecked="{Binding VideoSettings.VSync, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,14"/>
                                </StackPanel>
                            </Border>

                            <!-- Rendering Quality Panel -->
                            <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="คุณภาพกราฟิกและแสงเงา (Fidelity &amp; Shaders)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>

                                    <TextBlock Text="ลดรอยหยัก MSAA Anti-Aliasing (0, 2, 4, 8):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding VideoSettings.Msaa, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,14"/>

                                    <TextBlock Text="ความละเอียดเงา Shadow Map (1024, 2048, 4096):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding VideoSettings.ShadowMapSize, Mode=TwoWay}" Style="{StaticResource FuturisticTextBoxStyle}" Margin="0,0,0,14"/>

                                    <CheckBox Content="เปิด Fast Approximate Anti-Aliasing (FXAA)" IsChecked="{Binding VideoSettings.Fxaa, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,20"/>

                                    <Button Click="BtnSaveGraphics_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="22,12" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="บันทึกตั้งค่ากราฟิก (Save Graphics)" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 7: MOD INSTALLER (📦 ลงม็อดรถ/สนาม) -->
                    <Grid Visibility="{Binding IsModsTab, Converter={StaticResource BoolToVis}}" Margin="32,20,32,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="📦 ติดตั้งม็อดรถและสนาม (Drag &amp; Drop Mod Installer)" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="ติดตั้งม็อดไฟล์ .zip หรือ .7z ลงเกมโดยอัตโนมัติ" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <!-- Large Clean Drop Zone -->
                        <Border Grid.Row="1" Style="{StaticResource GlassPanelStyle}" BorderBrush="{StaticResource NeonRedBrush}" BorderThickness="1" CornerRadius="14" Padding="36">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="#26E11D48" BorderBrush="#80E11D48" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="⇩" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ลากไฟล์ .ZIP หรือ .7Z มาวางที่นี่เพื่อติดตั้งม็อดอัตโนมัติ" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="ระบบจะตรวจสอบโครงสร้างไฟล์และแยกไฟล์รถหรือสนามลงโฟลเดอร์ของเกมให้ทันที" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                                    <Button Click="BtnBrowseMod_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="20,12" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="เลือกไฟล์ม็อดจากเครื่อง... (Browse File)" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 8: CUSTOM SHADERS PATCH (⚡ ม็อดภาพ CSP) -->
                    <ScrollViewer Visibility="{Binding IsCspTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,20,32,36">

                            <!-- CSP Header & Action Buttons -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource RedBadgeStyle}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding CspSettings.StatusDisplay}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="#1400E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding CspSettings.WeatherImplementation, StringFormat='{}ENGINE: {0}'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="⚡ ตั้งค่าม็อดภาพ Custom Shaders Patch (CSP)" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="ยกระดับภาพกราฟิก สภาพอากาศ ฝน และแสงเงาสมจริง" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="BtnInstallCspZip_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="16,10" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📦" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ติดตั้งจากไฟล์ .ZIP" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnSaveCsp_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="20,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="บันทึกการตั้งค่า CSP" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Diagnostics & Master Toggle Glass Banner -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="18" Margin="0,0,0,18" BorderBrush="#33FF1E40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource RedNeonGradient}" Margin="0,0,14,0">
                                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ระบบม็อดภาพ Custom Shaders Patch (dwrite.dll)" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="เชื่อมต่อการเรนเดอร์ DirectX 11 ผ่าน dwrite.dll ในโฟลเดอร์หลักของเกม" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,5" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ไฟล์หลัก: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CspSettings.DwriteSizeMb, StringFormat='{}dwrite.dll ({0} MB)'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Content="เปิดใช้งาน CSP (Master Enabled)" IsChecked="{Binding CspSettings.MasterEnabled, Mode=TwoWay}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CSP Cloud Auto-Installer & Version Manager Card -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,20" BorderBrush="#4400E5FF" Background="#1209121D">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="☁" Foreground="{StaticResource CyberCyanBrush}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ดาวน์โหลดและอัปเดตเวอร์ชัน CSP อัตโนมัติ" Foreground="{StaticResource CyberCyanBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Background="#1A00E676" BorderBrush="#4400E676" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding CspSettings.UpdateStatusDisplay}" Foreground="#00E676" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="ดาวน์โหลดและติดตั้งตัวอัปเดต Custom Shaders Patch จากเซิร์ฟเวอร์ทางการ acstuff.club" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Click="BtnOneClickUpdateCsp_Click" Style="{StaticResource GlassSecondaryButtonStyle}" BorderBrush="#6600E5FF" Padding="16,8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" Foreground="{StaticResource CyberCyanBrush}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="อัปเดตเป็นเวอร์ชันแนะนำ (v0.2.11)" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="เลือกเวอร์ชัน CSP ที่ต้องการ:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding CspSettings.AvailableVersions}"
                                                      SelectedItem="{Binding SelectedCspVersion, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayTitle"
                                                      Style="{StaticResource FuturisticComboBoxStyle}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Click="BtnAutoInstallCsp_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="20,10" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⇩" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ดาวน์โหลดและติดตั้งเวอร์ชันที่เลือก" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Live CSP Download Progress Bar -->
                                    <Border Background="#18000000" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                                            Visibility="{Binding IsDownloadingCsp, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding CspDownloadStatusText}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CspDownloadProgress, StringFormat='{}{0:0}%'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding CspDownloadProgress}" Minimum="0" Maximum="100" Height="6" Background="#22FFFFFF" Foreground="{StaticResource CyberCyanBrush}" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 6 Core Feature Panels in 2 Columns -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT COLUMN -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                    <!-- CARD 1: WEATHER FX (WFX) -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🌦️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="สภาพอากาศสมจริง (Weather FX)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox Content="เปิดใช้งาน" IsChecked="{Binding CspSettings.WeatherFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <TextBlock Text="ระบบจำลองสภาพอากาศ (Weather Engine):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding CspSettings.AvailableWeatherImplementations}" SelectedItem="{Binding CspSettings.WeatherImplementation, Mode=TwoWay}" Style="{StaticResource FuturisticComboBoxStyle}" Margin="0,0,0,12"/>

                                            <TextBlock Text="สคริปต์ควบคุมสภาพอากาศ (Weather Controller):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding CspSettings.AvailableWeatherControllers}" SelectedItem="{Binding CspSettings.WeatherController, Mode=TwoWay}" Style="{StaticResource FuturisticComboBoxStyle}" Margin="0,0,0,12"/>

                                            <CheckBox Content="ท้องฟ้าและแสงสะท้อนสมจริง (Photorealistic Sky &amp; Mirage)" IsChecked="{Binding CspSettings.MirageReflections, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 2: LIGHTING FX (LFX) -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="💡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ระบบไฟหน้ารถและแสงเงา (Lighting FX)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox Content="เปิดใช้งาน" IsChecked="{Binding CspSettings.LightingFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ระยะลำแสงไฟหน้ารถ (Headlights Range):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding CspSettings.HeadlightsRangeMult, StringFormat='{}{0:F1}x'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.5" Maximum="2.0" Value="{Binding CspSettings.HeadlightsRangeMult, Mode=TwoWay}" SmallChange="0.1" LargeChange="0.2" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="จำนวนรถคู่แข่งที่เปิดไฟหน้าพร้อมกัน:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding CspSettings.CarsWithLights, StringFormat='{}{0} คัน'}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="4" Maximum="30" Value="{Binding CspSettings.CarsWithLights, Mode=TwoWay}" Margin="0,0,0,12"/>

                                            <CheckBox Content="ไฟหน้ารถคู่แข่งส่องสว่างแบบไดนามิก" IsChecked="{Binding CspSettings.DynamicCarLights, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="แสงสะท้อนในห้องโดยสารและพื้นถนน (Bounced Light)" IsChecked="{Binding CspSettings.BouncedLight, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="ความละเอียดแผนที่เงาเต็มความคมชัด (Full-Res Shadows)" IsChecked="{Binding CspSettings.FullResShadows, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 3: IMMERSION & REALISM FX -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🏎️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ความสมจริงในห้องโดยสาร (Immersion FX)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox Content="มุมมองคนขับเอียงตามแรงเหวี่ยง (Neck FX)" IsChecked="{Binding CspSettings.NeckFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความแรงการหันมองโค้ง (Lookahead Intensity):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding CspSettings.NeckLookaheadGain, StringFormat='{}{0:F2}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CspSettings.NeckLookaheadGain, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <CheckBox Content="กระจกมองหลัง 3D สมจริง (Smart Mirrors)" IsChecked="{Binding CspSettings.SmartMirrorEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="หญ้า 3D ข้างทาง (Grass FX)" IsChecked="{Binding CspSettings.GrassFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="ควันยางและประกายไฟเบรก (Particles FX)" IsChecked="{Binding CspSettings.ParticlesFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- RIGHT COLUMN -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                    <!-- CARD 4: EXTRA FX -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✨" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="กราฟิกยุคใหม่ (Extra FX)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox Content="เปิดใช้งาน" IsChecked="{Binding CspSettings.ExtraFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <CheckBox Content="แสงสะท้อนบนพื้นผิว (SSLR / Local Reflections)" IsChecked="{Binding CspSettings.SslrEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="แสงสะท้อนโดยรอบแบบธรรมชาติ (SSGI Global Illumination)" IsChecked="{Binding CspSettings.SsgiEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="เงาหลืบและมิติวัตถุ (HBAO+ Ambient Occlusion)" IsChecked="{Binding CspSettings.HbaoEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="ลดรอยหยักแบบเคลื่อนไหว (TAA Temporal Anti-Aliasing)" IsChecked="{Binding CspSettings.TaaEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,4">
                                                <CheckBox Content="ภาพเบลอตามความเร็ว (Motion Blur)" IsChecked="{Binding CspSettings.MotionBlurEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CspSettings.MotionBlurMult, StringFormat='{}{0:F2}x'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.1" Maximum="1.5" Value="{Binding CspSettings.MotionBlurMult, Mode=TwoWay}" SmallChange="0.05"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 5: RAIN FX -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🌧️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="สภาพอากาศฝนตก (Rain FX)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox Content="เปิดใช้งาน" IsChecked="{Binding CspSettings.RainFxEnabled, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <CheckBox Content="หยดน้ำฝนบนกระจกหน้ารถและที่ปัดน้ำฝน" IsChecked="{Binding CspSettings.ScreenDrops, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความหนาแน่นของหยดน้ำฝน:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding CspSettings.DropsIntensity, StringFormat='{}{0:F1}x'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.2" Maximum="2.0" Value="{Binding CspSettings.DropsIntensity, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ละอองน้ำกระเด็นจากล้อรถ (Tire Spray):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding CspSettings.SplashMult, StringFormat='{}{0:F2}x'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.05" Maximum="1.0" Value="{Binding CspSettings.SplashMult, Mode=TwoWay}" SmallChange="0.05"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 6: GRAPHICS ADJUSTMENTS -->
                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚙️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ปรับแต่งความคมชัดและระยะสายตา" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ระยะการมองเห็นโมเดลรายละเอียดสูง (LOD Distance):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding CspSettings.LodMultiplier, StringFormat='{}{0:F1}x'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.5" Maximum="3.0" Value="{Binding CspSettings.LodMultiplier, Mode=TwoWay}" SmallChange="0.1" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="ความคมชัด AMD FidelityFX CAS Sharpness:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding CspSettings.FfxCasSharpness, StringFormat='{}{0:P0}'}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CspSettings.FfxCasSharpness, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <TextBlock Text="เปิดระบบแก้ปัญหาภาพกระพริบ Z-Buffer Fighting และปรับความเนียนให้อัตโนมัติ" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 9: AUDIO & ASSISTS (🔊 เสียง & ตัวช่วยขับ) -->
                    <ScrollViewer Visibility="{Binding IsAudioTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,20,32,36">
                            <!-- Module Header -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="🔊 ตั้งค่าเสียงและตัวช่วยขับขี่ (Audio &amp; Driving Assists)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="22"/>
                                    <TextBlock Text="ปรับระดับเสียงจำลองและเปิด/ปิดระบบช่วยขับขี่ (ABS, TC, ESP)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT COLUMN: AUDIO MATRIX -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔊" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ปรับระดับเสียง (audio.ini)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Background="#1400E5FF" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="FMOD SOUND" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Master Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="ความดังเสียงหลัก (Master Volume):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayMasterVolume}" Foreground="{StaticResource NeonRedBrightBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.MasterVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Engine Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงเครื่องยนต์และท่อไอเสีย (Engine &amp; Exhaust):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayEngineVolume}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.EngineVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Opponents Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงรถคู่แข่ง (Opponents):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayOpponentsVolume}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.OpponentsVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Tyres Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงยางเอี๊ยดและแรงเสียดทาน (Tyres):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayTyresVolume}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.TyresVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Brakes Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงเบรก (Brakes Squeal):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayBrakesVolume}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.BrakesVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Wind Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงลมปะทะ (Wind):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayWindVolume}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.WindVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Surfaces Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงขอบทางและกรวดหิน (Surfaces &amp; Kerbs):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplaySurfacesVolume}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.SurfacesVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Weather Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงฝนและสภาพอากาศ (Weather FX):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayWeatherVolume}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.WeatherVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- UI Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงเมนูและวิทยุพิต (UI &amp; Pit Radio):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayUiSoundsVolume}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.UiSoundsVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,12"/>

                                            <!-- Music Volume -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="เสียงดนตรีประกอบ (Music):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding AudioSettings.DisplayMusicVolume}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding AudioSettings.MusicVolume, Mode=TwoWay}" SmallChange="0.05" Margin="0,0,0,18"/>

                                            <!-- Save Audio Button -->
                                            <Button Click="BtnSaveAudio_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="18,10" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="บันทึกตั้งค่าเสียง" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- RIGHT COLUMN: DRIVING ASSISTS MATRIX -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                    <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎛️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ระบบช่วยขับขี่ (assists.ini)" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DrivingAssists.DisplayAbsMode}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Anti-Lock Braking System (ABS) -->
                                            <TextBlock Text="ระบบเบรกป้องกันล้อล็อค (ABS):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Content="ปิด (OFF)" GroupName="AbsGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="0" Tag="0" IsChecked="{Binding DrivingAssists.IsAbsOff, Mode=TwoWay}" Click="AbsPill_Click" Margin="0,0,3,0"/>
                                                <RadioButton Content="ตามสเปกรถ (FACTORY)" GroupName="AbsGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="1" Tag="1" IsChecked="{Binding DrivingAssists.IsAbsFactory, Mode=TwoWay}" Click="AbsPill_Click" Margin="3,0,3,0"/>
                                                <RadioButton Content="เปิดตลอด (ON)" GroupName="AbsGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="2" Tag="2" IsChecked="{Binding DrivingAssists.IsAbsOn, Mode=TwoWay}" Click="AbsPill_Click" Margin="3,0,0,0"/>
                                            </Grid>

                                            <!-- Traction Control (TC) -->
                                            <TextBlock Text="ระบบป้องกันล้อหมุนฟรี (TCS):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Content="ปิด (OFF)" GroupName="TcGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="0" Tag="0" IsChecked="{Binding DrivingAssists.IsTcOff, Mode=TwoWay}" Click="TcPill_Click" Margin="0,0,3,0"/>
                                                <RadioButton Content="ตามสเปกรถ (FACTORY)" GroupName="TcGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="1" Tag="1" IsChecked="{Binding DrivingAssists.IsTcFactory, Mode=TwoWay}" Click="TcPill_Click" Margin="3,0,3,0"/>
                                                <RadioButton Content="เปิดตลอด (ON)" GroupName="TcGroup" Style="{StaticResource FilterPillStyle}" Grid.Column="2" Tag="2" IsChecked="{Binding DrivingAssists.IsTcOn, Mode=TwoWay}" Click="TcPill_Click" Margin="3,0,0,0"/>
                                            </Grid>

                                            <!-- Stability Control -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="ระบบควบคุมการทรงตัว (ESP Assist):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding DrivingAssists.DisplayStabilityControl}" Foreground="{StaticResource CyberCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding DrivingAssists.StabilityControl, Mode=TwoWay}" SmallChange="5" Margin="0,0,0,12"/>

                                            <Separator Background="#14FFFFFF" Margin="0,0,0,12"/>

                                            <!-- Mechanical Assists Toggles -->
                                            <TextBlock Text="ระบบช่วยขับอัตโนมัติ:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                            <CheckBox Content="เหยียบคลัตช์ให้อัตโนมัติ (Auto Clutch ป้องกันเครื่องดับ)" IsChecked="{Binding DrivingAssists.AutoClutch, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>

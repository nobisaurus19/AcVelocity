                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" Background="#2600E5FF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="ONLINE" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- AssettoCorsa.exe Binary -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🏁" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="ASSETTO CORSA 64-BIT (AssettoCorsa.exe)" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Text="พบไฟล์เกมหลักในโฟลเดอร์เรียบร้อย" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" Background="#2600E5FF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="VERIFIED" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Content Manager Status -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🎛️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="CONTENT MANAGER CONFIG" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Text="ตรวจพบการตั้งค่าใน AppData/Local/AcTools Content Manager" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" Background="#2600E5FF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="CONNECTED" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Custom Shaders Patch Core (dwrite.dll) -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="CUSTOM SHADERS PATCH CORE (dwrite.dll)" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Text="ไฟล์ฮุคกราฟิกติดตั้งในโฟลเดอร์หลักพร้อมทำงาน" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" Background="#2600E5FF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="INJECTED" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- DirectX 11 / DXGI Subsystem -->
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">

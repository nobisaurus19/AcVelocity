                                                    </StackPanel>
                                                    <TextBlock Text="💾" FontSize="24" Foreground="{StaticResource CyberCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.5"/>
                                                </Grid>
                                            </Border>

                                            <!-- Cache Size Display -->
                                            <Border Background="#14FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">

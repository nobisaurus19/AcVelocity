                                            <CheckBox Content="เปลี่ยนเกียร์ให้อัตโนมัติ (Auto Shifter)" IsChecked="{Binding DrivingAssists.AutoShifter, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="ช่วยเบรกเข้าโค้งอัตโนมัติ (Auto Brake)" IsChecked="{Binding DrivingAssists.AutoBrake, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="แสดงเส้นบอกไลน์การขับขี่ (Ideal Racing Line)" IsChecked="{Binding DrivingAssists.IdealLine, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <CheckBox Content="วอร์มยางให้พร้อมก่อนออกวิ่ง (Tyre Blankets)" IsChecked="{Binding DrivingAssists.TyreBlankets, Mode=TwoWay}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,12"/>


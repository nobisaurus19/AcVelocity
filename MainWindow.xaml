                                                        <TextBlock Text="ไฟล์แคช Shader ของ CSP, แคชเทเลเมทรี และไฟล์ล็อกชั่วคราว" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Text="⚡" FontSize="24" Foreground="{StaticResource NeonRedBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.5"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="การล้างแคชจะลบเฉพาะไฟล์คอมไพล์ Shader และไฟล์ขยะชั่วคราวอย่างปลอดภัย โดยจะไม่แตะต้องตัวรถ สนาม ลายรถ หรือการตั้งค่าใดๆ ของคุณเด็ดขาด" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

                                            <Button Click="BtnClearCache_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="18,10" HorizontalAlignment="Left">

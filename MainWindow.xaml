            <!-- ================= VEHICLE SELECTOR MODAL DIALOG ================= -->
            <Grid Grid.RowSpan="3" Panel.ZIndex="9999" 
                  Visibility="{Binding IsCarSelectorModalOpen, Converter={StaticResource BoolToVis}}" 
                  Background="#E605070C">
                
                <!-- Central Glassmorphic Modal Window -->
                <Border Width="1180" Height="780" 
                        Background="#F00D1018" 
                        BorderBrush="{StaticResource RedNeonGradient}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="24" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">


                                    <RadioButton Content="👑 ทางการ" GroupName="ModalCarOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="OFFICIAL" Click="CarOriginPill_Click"/>
                                    <RadioButton Content="📦 ม็อด" GroupName="ModalCarOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="MODS" Click="CarOriginPill_Click"/>
                                </StackPanel>

                                <!-- Class Category Pills -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="ประเภท:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <RadioButton Content="ทั้งหมด" GroupName="ModalClassFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL CLASSES" Click="ClassPill_Click"/>
                                    <RadioButton Content="STREET" GroupName="ModalClassFilter" Style="{StaticResource FilterPillStyle}" Tag="STREET" Click="ClassPill_Click"/>
                                    <RadioButton Content="RACE" GroupName="ModalClassFilter" Style="{StaticResource FilterPillStyle}" Tag="RACE" Click="ClassPill_Click"/>
                                    <RadioButton Content="DRIFT" GroupName="ModalClassFilter" Style="{StaticResource FilterPillStyle}" Tag="DRIFT" Click="ClassPill_Click"/>
                                    <RadioButton Content="SUPERCAR" GroupName="ModalClassFilter" Style="{StaticResource FilterPillStyle}" Tag="SUPERCAR" Click="ClassPill_Click"/>
                                    <RadioButton Content="TRAFFIC" GroupName="ModalClassFilter" Style="{StaticResource FilterPillStyle}" Tag="TRAFFIC" Click="ClassPill_Click"/>
                                </StackPanel>

                                <!-- Search Box -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="190" Text="{Binding CarSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FuturisticTextBoxStyle}"
                                             Tag="ค้นหารถ..."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. Grid of Cars -->
                        <ListBox Grid.Row="2" 
                                 ItemsSource="{Binding FilteredCars}" 
                                 SelectedItem="{Binding ModalPreviewCar}" 
                                 MouseDoubleClick="ModalCarList_MouseDoubleClick"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Margin="0,0,0,14">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel ItemSize="260,220" SpacingMode="None"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="0,0,10,12"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="UseLayoutRounding" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="modalCardBorder" Style="{StaticResource GlassPanelStyle}" Padding="12" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="modalCardBorder" Property="BorderBrush" Value="#80FF1E40"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="modalCardBorder" Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                                                        <Setter TargetName="modalCardBorder" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="110"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=300}" Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#CC0B0E14" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding OriginBadge}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding DisplayBrand}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Bhp}" Foreground="#E0E6ED" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DisplayClass}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 4. Action Footer -->
                        <Grid Grid.Row="3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="รถที่กำลังเลือก: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModalPreviewCar.DisplayTitle}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnCloseModal_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="18,10" Margin="0,0,10,0">
                                    <TextBlock Text="ยกเลิก (Cancel)" FontWeight="Bold"/>
                                </Button>
                                <Button Click="BtnConfirmModalCar_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="22,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ยืนยันเลือกรถ (Confirm Car)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= CIRCUIT SELECTOR MODAL DIALOG ================= -->
            <Grid Grid.RowSpan="3" Panel.ZIndex="9999" 
                  Visibility="{Binding IsTrackSelectorModalOpen, Converter={StaticResource BoolToVis}}" 
                  Background="#E605070C">
                
                <!-- Central Glassmorphic Modal Window -->
                <Border Width="1180" Height="780" 
                        Background="#F00D1018" 
                        BorderBrush="{StaticResource RedNeonGradient}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="24" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Modal Header -->
                            <RowDefinition Height="Auto"/> <!-- Filters Bar -->
                            <RowDefinition Height="*"/>    <!-- Track Grid -->
                            <RowDefinition Height="Auto"/> <!-- Action Footer -->
                        </Grid.RowDefinitions>

                        <!-- 1. Modal Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource RedNeonGradient}" Margin="0,0,10,0">
                                    <TextBlock Text="🏁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="เลือกสนามแข่ง (Circuit Selector)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                
                                <Border Style="{StaticResource RedBadgeStyle}">
                                    <TextBlock Text="{Binding FilteredTracks.Count, StringFormat='{}{0} สนาม'}" Foreground="{StaticResource CyberCyanBrush}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Button Click="BtnCloseTrackModal_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="14,6" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ปิด (Close [ESC])" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Filters Bar -->
                        <Border Grid.Row="1" Style="{StaticResource GlassPanelStyle}" Padding="14,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Origin Category Pills -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="ที่มา:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <RadioButton Content="ทั้งหมด" GroupName="ModalTrackOriginFilter" IsChecked="True" Style="{StaticResource FilterPillStyle}" Tag="ALL" Click="TrackOriginPill_Click"/>
                                    <RadioButton Content="👑 ทางการ" GroupName="ModalTrackOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="OFFICIAL" Click="TrackOriginPill_Click"/>
                                    <RadioButton Content="📦 ม็อด" GroupName="ModalTrackOriginFilter" Style="{StaticResource FilterPillStyle}" Tag="MODS" Click="TrackOriginPill_Click"/>
                                </StackPanel>

                                <!-- Search Box -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="260" Text="{Binding TrackSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FuturisticTextBoxStyle}"
                                             Tag="ค้นหาสนาม..."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. Grid of Tracks -->
                        <ListBox Grid.Row="2" 
                                 ItemsSource="{Binding FilteredTracks}" 
                                 SelectedItem="{Binding ModalPreviewTrack}" 
                                 MouseDoubleClick="ModalTrackList_MouseDoubleClick"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Margin="0,0,0,14">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel ItemSize="260,220" SpacingMode="None"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="0,0,10,12"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="UseLayoutRounding" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="modalTrackCardBorder" Style="{StaticResource GlassPanelStyle}" Padding="12" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="modalTrackCardBorder" Property="BorderBrush" Value="#8000E5FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="modalTrackCardBorder" Property="BorderBrush" Value="{StaticResource CyberCyanBrush}"/>
                                                        <Setter TargetName="modalTrackCardBorder" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="110"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="8" Background="#0A0D14" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="[ ไม่มีภาพตัวอย่าง ]" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource ImgConverter}, ConverterParameter=300}" Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#CC0B0E14" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding OriginBadge}" Foreground="{StaticResource CyberCyanBrush}" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayLocation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayLength}" Foreground="{StaticResource CyberCyanBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Pitboxes, StringFormat='{}{0} PITS'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 4. Action Footer -->
                        <Grid Grid.Row="3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="สนามที่กำลังเลือก: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModalPreviewTrack.DisplayTitle}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnCloseTrackModal_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="18,10" Margin="0,0,10,0">
                                    <TextBlock Text="ยกเลิก (Cancel)" FontWeight="Bold"/>
                                </Button>
                                <Button Click="BtnConfirmModalTrack_Click" Style="{StaticResource NeonLaunchButtonStyle}" Padding="22,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ยืนยันเลือกสนาม (Confirm Track)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>

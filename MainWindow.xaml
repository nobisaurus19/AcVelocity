                                </Border>
                                <TextBlock Text="เลือกรถที่ต้องการขับ (Vehicle Selector)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                
                                <Border Style="{StaticResource RedBadgeStyle}">
                                    <TextBlock Text="{Binding FilteredCars.Count, StringFormat='{}{0} คัน'}" Foreground="{StaticResource NeonRedBrightBrush}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Button Click="BtnCloseModal_Click" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="14,6" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ปิด (Close [ESC])" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Filters Bar -->
                        <Border Grid.Row="1" Style="{StaticResource GlassPanelStyle}" Padding="14,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Brand Selector -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="ยี่ห้อ:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="140" ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"

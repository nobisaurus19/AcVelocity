                                                        <TextBlock Text="🎮" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="STEAM CLIENT SUBSYSTEM" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
